#!/bin/bash
# Omarchy Post-Update Hook: Restore Antigravity Integration
# Location: ~/.config/omarchy/hooks/post-update.d/90-antigravity.hook

set -euo pipefail

CONFIG_DIR="$HOME/.config/omarchy"
AGENT_FILE="$CONFIG_DIR/defaults/agent"

# 1. Restore defaults only if user previously selected Antigravity as default.
# If the user has explicitly selected another agent, respect their choice.
if [[ -f "$AGENT_FILE" ]]; then
  current_agent=$(cat "$AGENT_FILE" | tr -d '[:space:]')
  if [[ "$current_agent" != "gemini" && "$current_agent" != "antigravity" ]]; then
    rm -f "$CONFIG_DIR/antigravity.default"
  fi
elif [[ -f "$CONFIG_DIR/antigravity.default" ]]; then
  mkdir -p "$CONFIG_DIR/defaults"
  echo "gemini" > "$AGENT_FILE"
fi

# 2. Ensure gemini shim exists in ~/.local/bin
mkdir -p "$HOME/.local/bin"
if [[ ! -x "$HOME/.local/bin/gemini" ]]; then
  cat <<'EOF' > "$HOME/.local/bin/gemini"
#!/bin/bash
exec agy --dangerously-skip-permissions "$@"
EOF
  chmod +x "$HOME/.local/bin/gemini"
fi

# 3. Ensure shell.json has antigravity enabled
SHELL_CONFIG="$CONFIG_DIR/shell.json"
if [[ -f "$SHELL_CONFIG" ]] && command -v jq >/dev/null 2>&1; then
  tmp=$(mktemp)
  jq '
    .bar.layout.right |= map(
      if .id == "omarchy.agents" or (.id | endswith(".agents")) then
        .providers.antigravity.enabled = true
      else
        .
      end
    )
  ' "$SHELL_CONFIG" > "$tmp" && mv "$tmp" "$SHELL_CONFIG"
fi

# 4. Trigger quota refresh
if [[ -x "$HOME/.local/bin/omarchy-agent-usage-update" ]]; then
  "$HOME/.local/bin/omarchy-agent-usage-update" --limits-only antigravity >/dev/null 2>&1 || true
fi
