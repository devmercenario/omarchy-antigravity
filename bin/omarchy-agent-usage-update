#!/bin/bash
# omarchy:summary=Update local usage records for all configured coding agents
# omarchy:args=[--force] [--limits-only] [agent-id...]
# omarchy:hidden=true

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
mkdir -p "$STATE_DIR"

force=""
limits_only=""
agents=()

while (( $# > 0 )); do
  case "$1" in
    --force) force="--force"; shift ;;
    --limits-only) limits_only="--limits-only"; shift ;;
    *) agents+=("$1"); shift ;;
  esac
done

# Collect all available agent collector scripts from both system and local bin
declare -A collectors

for script in /usr/share/omarchy/bin/omarchy-agent-usage-*; do
  [[ -x "$script" ]] || continue
  name=$(basename "$script")
  id="${name#omarchy-agent-usage-}"
  [[ "$id" == "update" || "$id" == "*" ]] && continue
  collectors["$id"]="$script"
done

for script in "$HOME/.local/bin/omarchy-agent-usage-*; do
  [[ -x "$script" ]] || continue
  name=$(basename "$script")
  id="${name#omarchy-agent-usage-}"
  [[ "$id" == "update" || "$id" == "*" ]] && continue
  collectors["$id"]="$script"
done

# If specific agents were requested, filter by them
target_ids=()
if (( ${#agents[@]} > 0 )); then
  for id in "${agents[@]}"; do
    if [[ -n "${collectors[$id]:-}" ]]; then
      target_ids+=("$id")
    fi
  done
else
  for id in "${!collectors[@]}"; do
    target_ids+=("$id")
  done
fi

for id in "${target_ids[@]}"; do
  script="${collectors[$id]}"
  target_file="$STATE_DIR/$id.json"
  tmp_file="$STATE_DIR/$id.json.tmp.$$"

  cmd=("$script")
  [[ -n "$force" ]] && cmd+=("$force")
  [[ -n "$limits_only" ]] && cmd+=("$limits_only")

  if "${cmd[@]}" > "$tmp_file" 2>/dev/null; then
    if [[ -s "$tmp_file" ]] && jq -e . "$tmp_file" >/dev/null 2>&1; then
      mv "$tmp_file" "$target_file"
    else
      rm -f "$tmp_file"
    fi
  else
    rm -f "$tmp_file"
  fi
done
