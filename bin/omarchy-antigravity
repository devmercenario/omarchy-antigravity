#!/bin/bash
# omarchy:summary=Antigravity integration helper for Omarchy
# omarchy:args=[auth|status|refresh|default|statusline|help]
# omarchy:group=agent

set -euo pipefail

# Marker lines that identify this plugin's own status line script (current
# marker, or the header every earlier release carried).
STATUSLINE_MARKER_RE='^# (omarchy-antigravity: statusline|Omarchy Antigravity CLI Statusline)$'
UPDATER_MARKER_RE='^# (omarchy-antigravity: agent-usage-update|omarchy:summary=Update local usage records for all configured coding agents)$'
AGENT_LAUNCHER_MARKER_RE='^# omarchy-antigravity: agent-launcher$'

# Omarchy 4.5 and later ship Antigravity support of their own: agent id
# "agy", a usage collector and the panel icon.
native_antigravity() {
  [[ -x "${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-agent-usage-agy" ]]
}

# True when $1 is a regular file (not a symlink) carrying marker regex $2.
has_marker() {
  [[ -f "$1" && ! -L "$1" ]] && grep -qE -- "$2" "$1" 2>/dev/null
}

# Temp files are removed on any exit; INT/TERM must exit explicitly.
TMP_FILES=()
cleanup_tmp() {
  (( ${#TMP_FILES[@]} == 0 )) || rm -f -- "${TMP_FILES[@]}"
}
trap cleanup_tmp EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# update_json FILE FILTER [jq args...]: rewrite FILE through FILTER only when
# the result differs, via a temp file next to it (atomic rename, same mode).
update_json() {
  local file="$1" filter="$2" tmp
  shift 2
  tmp=$(mktemp "$file.XXXXXX") || return 1
  TMP_FILES+=("$tmp")
  if ! jq "$@" "($filter) as \$new | if \$new == . then empty else \$new end" "$file" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if [[ ! -s "$tmp" ]]; then
    rm -f "$tmp"
    return 0
  fi
  chmod --reference="$file" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$file"
}

usage() {
  cat <<EOF
Usage: omarchy-antigravity <command>

Commands:
  auth, login     Launch Antigravity authentication in a terminal
  run [args...]   Execute Antigravity CLI (agy) using normal permission model
  status          Show current token, authentication state, and quotas
  refresh, update Force refresh quotas and update Omarchy bar widget
  default         Make Antigravity Omarchy's default agent
  adopt-native    Hand usage and launching over to Omarchy 4.5's built-in Antigravity
  statusline      Manage Antigravity CLI status bar [status|enable|disable]
  help            Show this help message

EOF
}

cmd="${1:-status}"

case "$cmd" in
  run)
    shift
    exec agy "$@"
    ;;
  default)
    # `omarchy default agent` only accepts Omarchy's own agents, so this is
    # the way to pick Antigravity; the plugin's omarchy-agent launcher then
    # opens agy from the keybinding, the menu and the bar.
    config_dir="$HOME/.config/omarchy"
    agent_file="$config_dir/defaults/agent"
    # Omarchy 4.5 knows Antigravity as "agy" and launches it itself.
    wanted="antigravity"
    native_antigravity && wanted="agy"
    mkdir -p "$config_dir/defaults"
    current=""
    [[ -f "$agent_file" ]] && current=$(tr -d '[:space:]' < "$agent_file")
    if [[ "$current" != "$wanted" ]]; then
      [[ -f "$agent_file" ]] && cp "$agent_file" "$agent_file.bak.$(date +%s)"
      echo "$wanted" > "$agent_file"
    fi
    touch "$config_dir/antigravity.default"
    echo "Antigravity is now the default agent${current:+ (was: $current)}."
    ;;
  adopt-native)
    # Omarchy 4.5's updater only runs Omarchy's own collectors, and its panel
    # calls omarchy-agent-usage-update through PATH. This plugin's collector
    # would add a second Antigravity tab, its 4.0-era updater would shadow
    # 4.5's, and its launcher is no longer needed: hand all of that over and
    # keep the status line and this helper. Safe to run more than once.
    if ! native_antigravity; then
      echo "This Omarchy has no built-in Antigravity support; nothing to hand over."
      exit 0
    fi
    bin_dir="$HOME/.local/bin"
    config_dir="$HOME/.config/omarchy"
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"

    # The collector's name is the plugin's own; the updater and launcher go
    # only when they are the plugin's copies (marker), and a helper the
    # plugin had backed up comes back.
    rm -f "$bin_dir/omarchy-agent-usage-antigravity" \
          "$state_dir/antigravity.json" "$state_dir/.antigravity.lock"
    if has_marker "$bin_dir/omarchy-agent" "$AGENT_LAUNCHER_MARKER_RE"; then
      rm -f "$bin_dir/omarchy-agent"
    fi
    if has_marker "$bin_dir/omarchy-agent-usage-update" "$UPDATER_MARKER_RE"; then
      rm -f "$bin_dir/omarchy-agent-usage-update"
      updater_bak="$bin_dir/.omarchy-agent-usage-update.bak"
      if [[ -f "$updater_bak" ]] && ! has_marker "$updater_bak" "$UPDATER_MARKER_RE"; then
        mv -f "$updater_bak" "$bin_dir/omarchy-agent-usage-update"
      fi
    fi

    # The plugin's "antigravity" default becomes Omarchy's own "agy".
    agent_file="$config_dir/defaults/agent"
    if [[ -f "$agent_file" && "$(tr -d '[:space:]' < "$agent_file")" == "antigravity" ]]; then
      echo "agy" > "$agent_file"
    fi

    # Put Omarchy's agents widget back where the bar shows this plugin's copy
    # of the 4.0 panel (it carries the Sign In button); the copy itself stays
    # in its folder. The plugin's provider switch means nothing to 4.5.
    shell_json="$config_dir/shell.json"
    if [[ -f "$shell_json" ]]; then
      while IFS= read -r widget_id; do
        [[ -n "$widget_id" ]] || continue
        if grep -q 'authActionBtn' "$config_dir/plugins/$widget_id/Panel.qml" 2>/dev/null; then
          cp -p "$shell_json" "$shell_json.bak.$(date +%s)"
          update_json "$shell_json" \
            '(.bar.layout[]?[]? | objects | select(.id? == $id)) |= (.id = "omarchy.agents")' \
            --arg id "$widget_id" || echo "⚠️  Could not switch $widget_id back in $shell_json." >&2
        fi
      done < <(jq -r '[.bar.layout[]?[]? | objects | .id? | strings
        | select(endswith(".agents") and . != "omarchy.agents")] | unique[]' "$shell_json" 2>/dev/null)
      update_json "$shell_json" '
        (.bar.layout[]?[]? | objects
          | select(.id? == "omarchy.agents" and .providers?.antigravity == {"enabled": true}))
        |= del(.providers.antigravity)
      ' || echo "⚠️  Could not update $shell_json." >&2
    fi
    echo "Antigravity usage and launching now come from Omarchy itself; the status line and this helper stay."
    ;;
  auth|login)
    echo "Launching Antigravity authentication..."
    if command -v omarchy-launch-tui >/dev/null 2>&1; then
      exec omarchy-launch-tui --app-id=org.omarchy.agent agy
    else
      exec agy
    fi
    ;;
  status)
    echo "Checking Antigravity credentials..."
    token_file="$HOME/.gemini/antigravity-cli/antigravity-oauth-token"
    auth_found=""
    if [[ -f "$token_file" && -s "$token_file" ]]; then
      auth_found="token file ($token_file)"
    elif secret-tool lookup service gemini username antigravity >/dev/null 2>&1; then
      # Exit status only: the secret itself never lands in a shell variable.
      auth_found="system keyring"
    fi

    if [[ -z "$auth_found" ]]; then
      echo "Status: ❌ Not authenticated"
      echo "Run 'omarchy-antigravity auth' to authenticate."
      exit 0
    fi
    echo "Status: ✅ Authenticated via $auth_found"
    collector=""
    if native_antigravity; then
      collector="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-agent-usage-agy"
    elif [[ -x "$HOME/.local/bin/omarchy-agent-usage-antigravity" ]]; then
      collector="$HOME/.local/bin/omarchy-agent-usage-antigravity"
    elif [[ -x "$(dirname "$0")/omarchy-agent-usage-antigravity" ]]; then
      collector="$(dirname "$0")/omarchy-agent-usage-antigravity"
    fi
    if [[ -n "$collector" ]]; then
      "$collector" --force | jq . 2>/dev/null || true
    fi
    ;;
  refresh|update)
    echo "Refreshing Antigravity quota..."
    refresh_rc=0
    if native_antigravity; then
      # Omarchy's own updater and collector, under its id for Antigravity.
      "${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-agent-usage-update" --force agy || refresh_rc=$?
    elif [[ -x "$HOME/.local/bin/omarchy-agent-usage-update" ]]; then
      "$HOME/.local/bin/omarchy-agent-usage-update" --force antigravity || refresh_rc=$?
    fi
    echo "Notifying Omarchy shell..."
    if command -v omarchy-shell >/dev/null 2>&1; then
      omarchy-shell ipc omarchy.agents refresh >/dev/null 2>&1 || true
    fi
    if (( refresh_rc != 0 )); then
      echo "Quota refresh failed (see the errors above)." >&2
      exit "$refresh_rc"
    fi
    echo "Quota refreshed!"
    ;;
  statusline)
    subcmd="${2:-status}"
    agy_dir="$HOME/.gemini/antigravity-cli"
    settings_file="$agy_dir/settings.json"
    statusline_script="$agy_dir/statusline.sh"
    case "$subcmd" in
      status)
        echo "Antigravity CLI Status Bar:"
        if [[ -f "$statusline_script" ]]; then
          echo "  Script: Installed ($statusline_script)"
        else
          echo "  Script: Not installed"
        fi
        if [[ -f "$settings_file" ]] && jq -e '.statusLine.enabled == true' "$settings_file" >/dev/null 2>&1; then
          echo "  Status: ✅ Enabled"
        else
          echo "  Status: ❌ Disabled"
        fi
        ;;
      enable)
        mkdir -p "$agy_dir"
        statusline_src=""
        if [[ -x "$HOME/.local/bin/omarchy-antigravity-statusline" ]]; then
          statusline_src="$HOME/.local/bin/omarchy-antigravity-statusline"
        elif [[ -x "$(dirname "$0")/omarchy-antigravity-statusline" ]]; then
          statusline_src="$(dirname "$0")/omarchy-antigravity-statusline"
        fi
        if [[ -n "$statusline_src" ]]; then
          # Back up a status line the user wrote, once; never the plugin's
          # own copy, which uninstall would otherwise "restore" for good.
          if [[ -f "$statusline_script" && ! -e "$statusline_script.bak" ]] &&
             ! cmp -s "$statusline_src" "$statusline_script" &&
             ! has_marker "$statusline_script" "$STATUSLINE_MARKER_RE"; then
            cp "$statusline_script" "$statusline_script.bak" 2>/dev/null || true
          fi
          cp -f --remove-destination "$statusline_src" "$statusline_script"
          chmod +x "$statusline_script"
        fi
        statusline_filter='.statusLine = {"type":"command","command":$s,"enabled":true}'
        if [[ -f "$settings_file" ]]; then
          update_json "$settings_file" "$statusline_filter" --arg s "$statusline_script"
        else
          tmp=$(mktemp "$settings_file.XXXXXX")
          TMP_FILES+=("$tmp")
          jq -n --arg s "$statusline_script" "{} | $statusline_filter" > "$tmp"
          mv -f "$tmp" "$settings_file"
        fi
        echo "✅ Antigravity CLI status bar enabled!"
        ;;
      disable)
        if [[ ! -f "$settings_file" ]]; then
          echo "Settings file not found."
        elif ! jq -e '.statusLine | type == "object"' "$settings_file" >/dev/null 2>&1; then
          # Nothing to disable; do not invent a partial statusLine entry.
          echo "No status bar is configured in $settings_file."
        else
          update_json "$settings_file" '.statusLine.enabled = false'
          echo "✅ Antigravity CLI status bar disabled."
        fi
        ;;
      *)
        echo "Usage: omarchy-antigravity statusline [status|enable|disable]"
        exit 1
        ;;
    esac
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
