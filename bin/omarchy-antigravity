#!/bin/bash
# omarchy:summary=Antigravity integration helper for Omarchy
# omarchy:args=[auth|status|refresh|statusline|help]
# omarchy:group=agent

set -euo pipefail

# Marker lines that identify this plugin's own status line script (current
# marker, or the header every earlier release carried).
STATUSLINE_MARKER_RE='^# (omarchy-antigravity: statusline|Omarchy Antigravity CLI Statusline)$'

# True when $1 is a regular file (not a symlink) carrying marker regex $2.
has_marker() {
  [[ -f "$1" && ! -L "$1" ]] && grep -qE -- "$2" "$1" 2>/dev/null
}

# Temp files are removed on any exit; INT/TERM must exit explicitly.
TMP_FILES=()
cleanup_tmp() {
  (( ${#TMP_FILES[@]} == 0 )) || rm -f -- "${TMP_FILES[@]}"
}
trap cleanup_tmp EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# update_json FILE FILTER [jq args...]: rewrite FILE through FILTER only when
# the result differs, via a temp file next to it (atomic rename, same mode).
update_json() {
  local file="$1" filter="$2" tmp
  shift 2
  tmp=$(mktemp "$file.XXXXXX") || return 1
  TMP_FILES+=("$tmp")
  if ! jq "$@" "($filter) as \$new | if \$new == . then empty else \$new end" "$file" > "$tmp"; then
    rm -f "$tmp"
    return 1
  fi
  if [[ ! -s "$tmp" ]]; then
    rm -f "$tmp"
    return 0
  fi
  chmod --reference="$file" "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$file"
}

usage() {
  cat <<EOF
Usage: omarchy-antigravity <command>

Commands:
  auth, login     Launch Antigravity authentication in a terminal
  run [args...]   Execute Antigravity CLI (agy) using normal permission model
  status          Show current token, authentication state, and quotas
  refresh, update Force refresh quotas and update Omarchy bar widget
  statusline      Manage Antigravity CLI status bar [status|enable|disable]
  help            Show this help message

EOF
}

cmd="${1:-status}"

case "$cmd" in
  run)
    shift
    exec agy "$@"
    ;;
  auth|login)
    echo "Launching Antigravity authentication..."
    if command -v omarchy-launch-tui >/dev/null 2>&1; then
      exec omarchy-launch-tui --app-id=org.omarchy.agent agy
    else
      exec agy
    fi
    ;;
  status)
    echo "Checking Antigravity credentials..."
    token_file="$HOME/.gemini/antigravity-cli/antigravity-oauth-token"
    auth_found=""
    if [[ -f "$token_file" && -s "$token_file" ]]; then
      auth_found="token file ($token_file)"
    elif secret-tool lookup service gemini username antigravity >/dev/null 2>&1; then
      # Exit status only: the secret itself never lands in a shell variable.
      auth_found="system keyring"
    fi

    if [[ -z "$auth_found" ]]; then
      echo "Status: ❌ Not authenticated"
      echo "Run 'omarchy-antigravity auth' to authenticate."
      exit 0
    fi
    echo "Status: ✅ Authenticated via $auth_found"
    collector=""
    if [[ -x "$HOME/.local/bin/omarchy-agent-usage-antigravity" ]]; then
      collector="$HOME/.local/bin/omarchy-agent-usage-antigravity"
    elif [[ -x "$(dirname "$0")/omarchy-agent-usage-antigravity" ]]; then
      collector="$(dirname "$0")/omarchy-agent-usage-antigravity"
    fi
    if [[ -n "$collector" ]]; then
      "$collector" --force | jq . 2>/dev/null || true
    fi
    ;;
  refresh|update)
    echo "Refreshing Antigravity quota..."
    refresh_rc=0
    if [[ -x "$HOME/.local/bin/omarchy-agent-usage-update" ]]; then
      "$HOME/.local/bin/omarchy-agent-usage-update" --force antigravity || refresh_rc=$?
    fi
    echo "Notifying Omarchy shell..."
    if command -v omarchy-shell >/dev/null 2>&1; then
      omarchy-shell ipc omarchy.agents refresh >/dev/null 2>&1 || true
    fi
    if (( refresh_rc != 0 )); then
      echo "Quota refresh failed (see the errors above)." >&2
      exit "$refresh_rc"
    fi
    echo "Quota refreshed!"
    ;;
  statusline)
    subcmd="${2:-status}"
    agy_dir="$HOME/.gemini/antigravity-cli"
    settings_file="$agy_dir/settings.json"
    statusline_script="$agy_dir/statusline.sh"
    case "$subcmd" in
      status)
        echo "Antigravity CLI Status Bar:"
        if [[ -f "$statusline_script" ]]; then
          echo "  Script: Installed ($statusline_script)"
        else
          echo "  Script: Not installed"
        fi
        if [[ -f "$settings_file" ]] && jq -e '.statusLine.enabled == true' "$settings_file" >/dev/null 2>&1; then
          echo "  Status: ✅ Enabled"
        else
          echo "  Status: ❌ Disabled"
        fi
        ;;
      enable)
        mkdir -p "$agy_dir"
        statusline_src=""
        if [[ -x "$HOME/.local/bin/omarchy-antigravity-statusline" ]]; then
          statusline_src="$HOME/.local/bin/omarchy-antigravity-statusline"
        elif [[ -x "$(dirname "$0")/omarchy-antigravity-statusline" ]]; then
          statusline_src="$(dirname "$0")/omarchy-antigravity-statusline"
        fi
        if [[ -n "$statusline_src" ]]; then
          # Back up a status line the user wrote, once; never the plugin's
          # own copy, which uninstall would otherwise "restore" for good.
          if [[ -f "$statusline_script" && ! -e "$statusline_script.bak" ]] &&
             ! cmp -s "$statusline_src" "$statusline_script" &&
             ! has_marker "$statusline_script" "$STATUSLINE_MARKER_RE"; then
            cp "$statusline_script" "$statusline_script.bak" 2>/dev/null || true
          fi
          cp -f --remove-destination "$statusline_src" "$statusline_script"
          chmod +x "$statusline_script"
        fi
        statusline_filter='.statusLine = {"type":"command","command":$s,"enabled":true}'
        if [[ -f "$settings_file" ]]; then
          update_json "$settings_file" "$statusline_filter" --arg s "$statusline_script"
        else
          tmp=$(mktemp "$settings_file.XXXXXX")
          TMP_FILES+=("$tmp")
          jq -n --arg s "$statusline_script" "{} | $statusline_filter" > "$tmp"
          mv -f "$tmp" "$settings_file"
        fi
        echo "✅ Antigravity CLI status bar enabled!"
        ;;
      disable)
        if [[ ! -f "$settings_file" ]]; then
          echo "Settings file not found."
        elif ! jq -e '.statusLine | type == "object"' "$settings_file" >/dev/null 2>&1; then
          # Nothing to disable; do not invent a partial statusLine entry.
          echo "No status bar is configured in $settings_file."
        else
          update_json "$settings_file" '.statusLine.enabled = false'
          echo "✅ Antigravity CLI status bar disabled."
        fi
        ;;
      *)
        echo "Usage: omarchy-antigravity statusline [status|enable|disable]"
        exit 1
        ;;
    esac
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
