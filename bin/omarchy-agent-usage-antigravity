CACHE_TTL_SECONDS = 60
# The quota API is cheap but stopped reporting the Gemini pools. `agy -p
# /usage` still reports them, yet every call starts all of the user's MCP
# servers, so its answer is reused for much longer than the API's.
AGY_USAGE_TTL_SECONDS = 600
