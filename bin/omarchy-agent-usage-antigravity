    "1071006060591-tmhssin2h21lcre235vtolojh4g403ep.apps.googleusercontent.com"
)
_DEFAULT_OAUTH_CLIENT_SECRET = "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"
OAUTH_CLIENT_ID = os.getenv("ANTIGRAVITY_CLIENT_ID") or _DEFAULT_OAUTH_CLIENT_ID
OAUTH_CLIENT_SECRET = os.getenv("ANTIGRAVITY_CLIENT_SECRET") or _DEFAULT_OAUTH_CLIENT_SECRET
STRICT_CLIENT = os.getenv("ANTIGRAVITY_STRICT_CLIENT", "").strip().lower() in (
    "1", "true", "yes", "on"
