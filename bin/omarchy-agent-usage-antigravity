HTTP_ERROR_BODY_MAX_BYTES = 4 * 1024
# Client errors that a retry can actually fix.
RETRYABLE_CLIENT_STATUSES = (408, 429)


class BoundedReadError(Exception):
    """Raised when a remote HTTP response exceeds its byte ceiling."""


class HttpFetchError(Exception):
    """Raised when a remote HTTP request fails or returns an invalid body."""

    def __init__(self, message, status=None, retryable=True):
        super().__init__(message)
        self.status = status
        self.retryable = retryable


class HelperTimeout(Exception):
    """Raised when a helper ran out of time; not an answer worth caching."""


# C0/C1 controls, line/paragraph separators and invisible bidi/format marks.
_CONTROL_CHARS = re.compile(
    "[\x00-\x1f\x7f-\x9f​-‏ -‮⁠-⁯﻿]+"
)


def clean_text(value, limit):
    """``value`` as one line of at most ``limit`` characters, controls removed.

    Everything bound for the panel, a notification or the shell log goes
    through here: server error bodies, redirect targets, exception text and
    cached strings are not trusted to be short or printable.
    """
    text = _CONTROL_CHARS.sub(" ", str(value)).strip()
    if len(text) > limit:
        text = text[:limit - 1].rstrip() + "…"
    return text


def _text_field(value, limit):
    """A string field from a remote or cached document, cleaned; "" otherwise."""
    return clean_text(value, limit) if isinstance(value, str) else ""


_TOKEN_RE = re.compile(r"[\x21-\x7e]{1,%d}" % MAX_TOKEN_CHARS)


def valid_token(value):
    """True for a plausible OAuth token: bounded printable ASCII, no whitespace."""
    return isinstance(value, str) and _TOKEN_RE.fullmatch(value) is not None


_deadline = None


def start_run_budget(seconds=None):
    global _deadline
    # Read at call time, like the watchdog's delay, so both follow one value.
    _deadline = time.monotonic() + (RUN_BUDGET_SECONDS if seconds is None else seconds)


def remaining_budget(cap):
    """Seconds one step may take: ``cap``, bounded by what is left of the run."""
    if _deadline is None:
        return cap
    return max(0.0, min(cap, _deadline - time.monotonic()))


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Refuse HTTP redirects so credential-bearing requests are never replayed."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(
            req.full_url, code, f"refusing redirect to {clean_text(newurl, 200)}", headers, fp
        )


# Refuse redirects process-wide: a redirect could replay the OAuth client secret
# and refresh token (or a quota bearer token) to an attacker-chosen host.
urllib.request.install_opener(urllib.request.build_opener(_NoRedirectHandler))


def debug_enabled():
    """True when verbose diagnostics are requested via env or ``--debug``."""
    return os.getenv("OMARCHY_ANTIGRAVITY_DEBUG", "").strip().lower() in (
        "1", "true", "yes", "on"
    )


def log_debug(message):
    if debug_enabled():
        sys.stderr.write(
            f"omarchy-agent-usage-antigravity: [debug] {clean_text(message, MAX_LOG_CHARS)}\n"
        )


def log_warn(message):
    # The updater forwards stderr to the Quickshell log: one clean line each.
    sys.stderr.write(f"omarchy-agent-usage-antigravity: {clean_text(message, MAX_LOG_CHARS)}\n")


def read_bounded(resp, max_bytes):
    """Read at most ``max_bytes`` bytes from an HTTP response body.

    Content-Length is checked when the server provides it and, regardless of
    what the server claims, no more than ``max_bytes`` + 1 bytes are ever read
    so an oversized or continuously delivered response cannot force unbounded
    allocation. Raises :class:`BoundedReadError` when the body is too large.
    """
    limit = max(1, int(max_bytes))

    headers = getattr(resp, "headers", None)
    if headers is not None:
        declared = None
        try:
            declared = headers.get("Content-Length")
        except Exception:
            declared = None
        if declared is not None:
            try:
                declared_length = int(declared)
            except (TypeError, ValueError):
                declared_length = None
            if declared_length is not None and declared_length > limit:
                raise BoundedReadError(
                    f"HTTP response Content-Length {declared_length} exceeds limit of {limit} bytes"
                )

    chunks = []
    remaining = limit + 1
    while remaining > 0:
        # The socket timeout only bounds each read; a server trickling bytes
        # would otherwise keep this loop going past the run's total deadline.
        if remaining_budget(1) <= 0:
            raise HttpFetchError("HTTP response not received within the run time budget")
        chunk = resp.read(min(65536, remaining))
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)

    body = b"".join(chunks)
    if len(body) > limit:
        raise BoundedReadError(f"HTTP response body exceeds limit of {limit} bytes")
    return body


def fetch_json(req, timeout, max_bytes, error_label):
    """Perform an HTTP request and parse a bounded JSON response.

    Both success bodies and HTTPError bodies are read through
    :func:`read_bounded` so every response and error path is size-limited, and
    ``timeout`` is cut to what is left of the run budget.
    """
    timeout = remaining_budget(timeout)
    if timeout <= 0:
        raise HttpFetchError(f"{error_label}: run time budget exhausted")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = read_bounded(resp, max_bytes)
    except (ValueError, TypeError):
        # http.client rejects a header it cannot send with the value quoted in
        # the message, i.e. the bearer token: never pass that text on. The
        # same request fails the same way, so it is not retried either.
        raise HttpFetchError(
            f"{error_label}: the request could not be built", retryable=False
        ) from None
    except urllib.error.HTTPError as e:
        detail = f"{error_label}: HTTP {e.code} {clean_text(e.reason, 200)}".strip()
        snippet = ""
        try:
            snippet = read_bounded(e, min(max_bytes, HTTP_ERROR_BODY_MAX_BYTES)).decode(
                "utf-8", errors="replace"
            ).strip()
        except Exception:
            snippet = ""
        finally:
            try:
                e.close()
            except Exception:
                pass
        if snippet:
            detail = f"{detail}: {clean_text(snippet, 512)}"
        raise HttpFetchError(detail, status=e.code) from e

    try:
        return json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as e:
        raise HttpFetchError(f"{error_label}: invalid JSON response") from e


def is_agy_running():
    """Check via OS process table (pgrep) if at least one agy process is active."""
    pgrep = resolve_tool("pgrep")
    timeout = remaining_budget(2)
    if pgrep is None or timeout <= 0:
        return True
    try:
        res = subprocess.run(
            [pgrep, "-x", "agy"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        )
        return res.returncode == 0
    except Exception:
        return True


def ensure_dir(path):
    """Create ``path`` as this user's private directory, or refuse to use it.

    An existing path must be a real directory (not a symlink) owned by this
    user. It is narrowed to 0700 and refused when it stays group- or
    world-accessible, so a cache is never published where others can read it
    or swap it out.
    """
    os.makedirs(path, mode=0o700, exist_ok=True)
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode):
        raise OSError(f"Refusing to use a non-directory or symlink path: {path}")
    if st.st_uid != os.getuid():
        raise OSError(f"Refusing a directory owned by uid {st.st_uid}: {path}")
    if st.st_mode & 0o077:
        try:
            os.chmod(path, 0o700)
        except OSError:
            pass
        st = os.lstat(path)
        if not stat.S_ISDIR(st.st_mode) or st.st_mode & 0o077:
            raise OSError(
                "Refusing a directory that stays group/world accessible "
                f"({oct(stat.S_IMODE(st.st_mode))}): {path}"
            )


def _user_private_group(gid):
    """True when ``gid`` is this user's primary group and holds no one else.

    umask-002 setups give every user a private group, and ~/.local/bin (and
    what is installed in it) ends up group-writable; that is only as safe as
    0755 while the group is this user's alone.
    """
    if gid != os.getgid():
        return False
    try:
        user = pwd.getpwuid(os.getuid()).pw_name
        group = grp.getgrgid(gid)
    except (KeyError, OSError):
        return False
    return group.gr_name == user and set(group.gr_mem) <= {user}


def _trusted_owner_and_mode(st):
    """Owned by root or this user, and writable by no one else.

    Group write is tolerated only on this user's own entries in their private
    group (see :func:`_user_private_group`).
    """
    uid = os.getuid()
    if st.st_uid not in (0, uid) or st.st_mode & 0o002:
        return False
    if st.st_mode & 0o020:
        return st.st_uid == uid and _user_private_group(st.st_gid)
    return True


def _trusted_parent_chain(path):
    """True when every ancestor directory of ``path`` is trusted.

    Rejects directories someone else could write to (see
    :func:`_trusted_owner_and_mode`), so a binary reached through an
    attacker-writable directory cannot be trusted even if its immediate parent
    looks safe.
    """
    current = os.path.dirname(path) or "/"
    while True:
        try:
            st = os.stat(current)
        except OSError:
            return False
        if not stat.S_ISDIR(st.st_mode) or not _trusted_owner_and_mode(st):
            return False
        parent = os.path.dirname(current)
        if parent == current:
            return True
        current = parent


def resolve_tool(name):
    """Resolve an external helper to an absolute path in a trusted directory.

    ``shutil.which`` honours ``PATH``; a poisoned ``PATH`` entry could otherwise
    substitute an attacker-controlled ``agy`` or ``secret-tool``. Reject
    candidates that are not executable regular files, that are owned by
    neither root nor this user or writable by someone else, or whose parent
    chain holds a directory someone else could write to. Returns the resolved
    path, or ``None`` when nothing trusted is found.
    """
    path = shutil.which(name)
    if not path:
        return None
    try:
        path = os.path.realpath(path)
        st = os.stat(path)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode) or not os.access(path, os.X_OK):
        return None
    if not _trusted_owner_and_mode(st) or not _trusted_parent_chain(path):
        return None
    return path


def get_token_from_file():
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(TOKEN_FILE, flags)
    except FileNotFoundError:
        return None, f"Token file not found: {TOKEN_FILE}"
    except OSError as e:
        return None, f"Failed to open token file: {e}"

    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, f"Token file is not a regular file: {TOKEN_FILE}"
        if st.st_uid != os.getuid():
            return None, f"Token file owner mismatch (uid {st.st_uid} != {os.getuid()}): {TOKEN_FILE}"
        if (st.st_mode & 0o077) != 0:
            return None, f"Token file has insecure permissions ({oct(st.st_mode & 0o777)}), must be private to owner (0600)"
        if st.st_size > MAX_TOKEN_FILE_SIZE:
            return None, f"Token file exceeds maximum allowed size ({st.st_size} > {MAX_TOKEN_FILE_SIZE} bytes)"

        raw = os.read(fd, MAX_TOKEN_FILE_SIZE + 1)
        if len(raw) > MAX_TOKEN_FILE_SIZE:
            return None, f"Token file content exceeds maximum allowed size of {MAX_TOKEN_FILE_SIZE} bytes"

        data = json.loads(raw.decode("utf-8"))
        if not data or not isinstance(data, dict) or "token" not in data:
            return None, "Invalid token structure in token file"
        return data, ""
    except Exception as e:
        return None, f"Failed to read token file: {e}"
    finally:
        os.close(fd)


def get_token_from_keyring():
    secret_tool = resolve_tool("secret-tool")
    if secret_tool is None:
        return None, "secret-tool is not available in a trusted PATH"
    try:
        code, raw_bytes, truncated = run_bounded_stdout(
            [secret_tool, "lookup", "service", "gemini", "username", "antigravity"],
            timeout=5,
        )
        if truncated:
            return None, "Keyring credential exceeds maximum allowed size"
        if code != 0:
            return None, "No Antigravity credentials found in keyring"
        raw = raw_bytes.decode("utf-8", errors="ignore").strip()
        if not raw:
            return None, "No Antigravity credentials found in keyring"
        data = json.loads(raw)
        return data, ""
    except Exception as e:
        return None, f"Failed to read keyring: {e}"


def get_credentials():
    data, err_file = get_token_from_file()
    if data:
        return data, "file", ""

    data, err_keyring = get_token_from_keyring()
    if data:
        return data, "keyring", ""

    return None, None, f"No Antigravity credentials found in token file or keyring ({err_file}; {err_keyring})"


def _validate_private_descriptor(fd, label):
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        raise OSError(f"Temporary file is not a regular file: {label}")
    if st.st_uid != os.getuid():
        raise OSError(f"Temporary file owner mismatch (uid {st.st_uid} != {os.getuid()})")
    if (st.st_mode & 0o077) != 0:
        raise OSError(f"Temporary file has insecure permissions ({oct(st.st_mode & 0o777)})")


def _write_all(fd, payload):
    total_written = 0
    while total_written < len(payload):
        written = os.write(fd, payload[total_written:])
        if written == 0:
            raise OSError("Failed to write payload to temporary file")
        total_written += written


def atomic_write_private(file_path, data, max_bytes=None, error_label="private file"):
    """Atomically publish ``data`` as private JSON to ``file_path``.

    The temporary file is created with ``mkstemp`` (mode 0600, ``O_EXCL``) in the
    target directory, validated on its descriptor, written, fsynced, and
    published with ``os.replace`` so an existing symlink is replaced rather than
    followed. Shared by every cache the collector persists.
    """
    fd = None
    tmp_path = None
    try:
        parent_dir = os.path.dirname(file_path)
        ensure_dir(parent_dir)

        prefix = f".{os.path.basename(file_path)}.tmp."
        fd, tmp_path = tempfile.mkstemp(dir=parent_dir, prefix=prefix)
        _validate_private_descriptor(fd, tmp_path)

        payload = json.dumps(data, indent=2).encode("utf-8")
        if max_bytes is not None and len(payload) > max_bytes:
            raise ValueError(
                f"{error_label} payload exceeds maximum allowed size "
                f"({len(payload)} > {max_bytes} bytes)"
            )
        _write_all(fd, payload)

        os.fsync(fd)
        os.close(fd)
        fd = None

        os.replace(tmp_path, file_path)
        tmp_path = None
        return True
    except Exception as e:
        log_warn(f"failed to save {error_label}: {e}")
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass


def save_private_json(file_path, data):
    # Capped at what read_private_json accepts: a cache too big to be read
    # back would never hit and only cost a rewrite on every run.
    return atomic_write_private(
        file_path, data, max_bytes=MAX_CACHE_FILE_SIZE,
        error_label=os.path.basename(file_path),
    )


def read_token():
    """Return ``(token, error)`` from agy's stored credentials, read-only."""
    data, _source, err = get_credentials()
    token = data.get("token") if isinstance(data, dict) else None
    if not isinstance(token, dict):
        return None, err or "Invalid token structure in Antigravity credentials"
    return token, ""


def account_id(token):
    """Short, non-secret fingerprint of the signed-in account's credentials."""
    refresh_token = token.get("refresh_token") if isinstance(token, dict) else None
    if not valid_token(refresh_token):
        return ""
    return hashlib.sha256(refresh_token.encode("utf-8")).hexdigest()[:16]


def _token_fresh(expiry):
    """True while an access token has more than two minutes left.

    A token without an expiry is trusted as before; one whose expiry cannot be
    parsed is treated as stale so it gets replaced.
    """
    if not expiry:
        return True
    try:
        exp_dt = datetime.fromisoformat(str(expiry))
    except ValueError:
        return False
    if exp_dt.tzinfo is None:
        exp_dt = exp_dt.replace(tzinfo=timezone.utc)
    return (exp_dt - datetime.now(timezone.utc)).total_seconds() >= 120


def _refresh_access_token(refresh_token):
    """Mint a new access token; returns ``(access_token, expiry_iso)``."""
    if STRICT_CLIENT and not (
        os.getenv("ANTIGRAVITY_CLIENT_ID") and os.getenv("ANTIGRAVITY_CLIENT_SECRET")
    ):
        raise RuntimeError(
            "strict client mode requires ANTIGRAVITY_CLIENT_ID and "
            "ANTIGRAVITY_CLIENT_SECRET; refusing to use the built-in default"
        )
    params = urllib.parse.urlencode({
        "client_id": OAUTH_CLIENT_ID,
        "client_secret": OAUTH_CLIENT_SECRET,
        "refresh_token": refresh_token,
        "grant_type": "refresh_token"
    }).encode("utf-8")
    req = urllib.request.Request("https://oauth2.googleapis.com/token", data=params, method="POST")
    res = fetch_json(
        req,
        timeout=10,
        max_bytes=OAUTH_TOKEN_RESPONSE_MAX_BYTES,
        error_label="OAuth token refresh failed",
    )
    new_token = res.get("access_token") if isinstance(res, dict) else None
    if not valid_token(new_token):
        raise HttpFetchError(
            "OAuth token refresh failed: no usable access_token in response", retryable=False
        )
    expires_in = res.get("expires_in", 3600)
    if isinstance(expires_in, bool) or not isinstance(expires_in, (int, float)) \
            or not 0 <= expires_in <= 86400:
        expires_in = 3600
    expiry = datetime.now(timezone.utc) + timedelta(seconds=expires_in)
    return new_token, expiry.isoformat()


def get_valid_access_token(token, token_err=""):
    """Return ``(access_token, error)`` for agy's credentials.

    agy's own access token is used while it is fresh. Otherwise the collector
    refreshes one for itself and keeps it in its own private cache, keyed by
    account, so agy's token file and keyring entry are only ever read and the
    collector never races the CLI's own token refresh.
    """
    if not isinstance(token, dict):
        return None, token_err or "No Antigravity credentials found"

    # A corrupt token (a stray newline, binary junk) is treated as missing:
    # sent on, it only fails as a header error quoting the token itself.
    access_token = token.get("access_token")
    if not valid_token(access_token):
        access_token = None
    if access_token and _token_fresh(token.get("expiry")):
        return access_token, ""

    account = account_id(token)
    cached, _ = read_private_json(ACCESS_TOKEN_CACHE_FILE, require_private=True)
    if (
        account
        and isinstance(cached, dict)
        and cached.get("account") == account
        and valid_token(cached.get("access_token"))
        and _token_fresh(cached.get("expiry"))
    ):
        return cached["access_token"], ""

    refresh_token = token.get("refresh_token")
    if valid_token(refresh_token):
        try:
            new_token, expiry = _refresh_access_token(refresh_token)
            save_private_json(ACCESS_TOKEN_CACHE_FILE, {
                "account": account,
                "access_token": new_token,
                "expiry": expiry,
            })
            return new_token, ""
        except Exception as e:
            log_warn(f"token refresh error: {e}")

    if access_token:
        # Best effort: the server is the judge of a token we could not renew.
        return access_token, ""
    return None, "Unable to obtain valid access token"


def read_private_json(file_path, max_bytes=MAX_CACHE_FILE_SIZE, require_private=False):
    """Read a user-owned JSON file through a bounded, no-follow descriptor.

    Rejects symlinks, non-regular files, files owned by another user, and
    payloads larger than ``max_bytes`` before any decoding or parsing happens.
    With ``require_private`` a file any group or other user can access is
    rejected too, as the token file is: a secret that may have leaked is
    replaced rather than used. Returns ``(data, stat_result)`` on success and
    ``(None, None)`` otherwise.
    """
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(file_path, flags)
    except OSError:
        return None, None

    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, None
        if st.st_uid != os.getuid():
            return None, None
        if require_private and st.st_mode & 0o077:
            return None, None
        if st.st_size > max_bytes:
            return None, None
        raw = os.read(fd, max_bytes + 1)
        if len(raw) > max_bytes:
            return None, None
        return json.loads(raw.decode("utf-8")), st
    except Exception:
        return None, None
    finally:
        os.close(fd)


def run_bounded_stdout(args, timeout, max_bytes=MAX_SUBPROCESS_OUTPUT_BYTES):
    """Run a command and capture a bounded amount of stdout.

    Returns ``(returncode, stdout_bytes, truncated)``, where ``truncated`` is
    False or says why the output is incomplete: ``"size"`` (more than
    ``max_bytes``), ``"time"`` (``timeout``, cut to the run budget, ran out, or
    no budget was left to start) or ``"held"`` (a descendant that left the
    group kept the pipe open). The child is killed on size and time, so a
    misbehaving helper cannot force unbounded allocation.

    The child gets its own process group. Once it exits (or is killed),
    whatever is left of that group is killed too, so a descendant (one of
    agy's MCP servers) can neither outlive the run nor hold the pipe open and
    stall it past its deadline. The group is tracked for signals and the
    watchdog from the moment it exists until its output is drained, is killed
    on any exception (a signal's SystemExit, KeyboardInterrupt), and the pipe
    is closed only after the reader is done, so closing can never block.
    """
    timeout = remaining_budget(timeout)
    if timeout <= 0:
        return None, b"", "time"
    try:
        proc = _spawn_tracked(args)
    except OSError:
        return None, b"", False

    state = {"data": bytearray(), "truncated": False}
    stdout_fd = proc.stdout.fileno()

    def _reader():
        # Raw reads: they return whatever is available and never hold the
        # buffered reader's lock that a close() would wait on.
        try:
            while True:
                chunk = os.read(stdout_fd, 65536)
                if not chunk:
                    break
                if len(state["data"]) + len(chunk) > max_bytes:
                    state["truncated"] = "size"
                    kill_process_tree(proc)
                    break
                state["data"].extend(chunk)
        except OSError:
            pass

    reader = threading.Thread(target=_reader, daemon=True)
    reader.start()
    try:
        if not _wait_exited(proc, timeout):
            state["truncated"] = "time"
        # The exited helper is still unreaped, so its zombie keeps the group id
        # reserved and this reaches exactly the helper and its descendants.
        kill_process_tree(proc)
        returncode = proc.wait()
        reader.join(timeout=HELPER_DRAIN_SECONDS)
    except BaseException:
        # A signal's SystemExit, a KeyboardInterrupt: the group goes too.
        kill_process_tree(proc)
        raise
    finally:
        _active_procs.discard(proc)
    if reader.is_alive():
        # Only a descendant that left the group (setsid) can still hold the
        # pipe. Closing under a blocked read could block or let a reused fd be
        # read, so the daemon thread and the fd are left to the process exit.
        state["truncated"] = state["truncated"] or "held"
        log_warn(f"{os.path.basename(str(args[0]))}: output still held open after exit; abandoned")
    else:
        try:
            proc.stdout.close()
        except OSError:
            pass
    return returncode, bytes(state["data"]), state["truncated"]


HELPER_DRAIN_SECONDS = 2


def _wait_exited(proc, timeout):
    """Wait up to ``timeout`` seconds for ``proc`` to exit, without reaping it."""
    deadline = time.monotonic() + timeout
    while True:
        try:
            if os.waitid(os.P_PID, proc.pid, os.WEXITED | os.WNOHANG | os.WNOWAIT) is not None:
                return True
        except ChildProcessError:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.05)


_active_procs = set()
# Held while a helper is started and registered, and by the watchdog from its
# sweep to the exit, so no helper can start untracked or after the sweep.
_procs_lock = threading.Lock()
_spawning = False
_deferred_signals = []
# `timeout` in the updater, Ctrl-C or a closed terminal under
# `omarchy-antigravity status`, and a quit key all reach only our own group.
CLEANUP_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT)


def _spawn_tracked(args):
    """Start ``args`` in its own session and track it, as one step.

    A signal handled between Popen returning and the registration would exit
    without killing the new group, which lives in its own session and would
    outlive the run. The handler therefore defers while this runs (Python
    runs handlers only between bytecodes of the main thread, so nothing gets
    in between), and a deferred signal is acted on once the group is tracked.
    Blocking the signals with pthread_sigmask instead would leak the blocked
    mask into the helper: exec keeps it, so agy and its MCP servers would
    ignore SIGTERM, SIGINT and SIGHUP for life.
    """
    global _spawning
    with _procs_lock:
        _spawning = True
        try:
            proc = subprocess.Popen(
                args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True
            )
            _active_procs.add(proc)
        finally:
            _spawning = False
            if _deferred_signals:
                _terminate_children(_deferred_signals[0], None)
    return proc


def kill_process_tree(proc):
    """SIGKILL a child started by :func:`run_bounded_stdout` and its group.

    A reaped child's group was killed before it was reaped, and its id may
    name someone else's group by now: it is left alone.
    """
    if proc.returncode is not None:
        return
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    except OSError:
        proc.kill()


def _terminate_children(signum, _frame):
    # The helpers live in their own sessions and would outlive us otherwise.
    if _spawning:
        _deferred_signals.append(signum)
        return
    for proc in list(_active_procs):
        kill_process_tree(proc)
    sys.exit(128 + signum)


def install_signal_handlers():
    for signum in CLEANUP_SIGNALS:
        signal.signal(signum, _terminate_children)


_record_lock = threading.Lock()
_record_emitted = False


def emit_record(record, wait=-1):
    """Print the run's one record; any later one (the watchdog's) is dropped.

    Returns False when a record was already printed or, with ``wait``, the
    lock could not be had in time.
    """
    global _record_emitted
    if not _record_lock.acquire(timeout=wait):
        return False
    try:
        if _record_emitted:
            return False
        _record_emitted = True
        print(json.dumps(record, separators=(",", ":")), flush=True)
        return True
    finally:
        _record_lock.release()


def start_watchdog(seconds):
    """Arm the run's last resort; set the returned event to disarm it."""
    disarmed = threading.Event()

    def _watch():
        if not disarmed.wait(seconds):
            _expire_run()

    threading.Thread(target=_watch, name="run-watchdog", daemon=True).start()
    return disarmed


def _expire_run():
    """End a run stuck past its budget: kill the helpers, say so, exit.

    The main thread may be blocked in C (getaddrinfo, connect, a TLS
    handshake, a trickled status line), where neither the budget nor a signal
    handler reaches it, so only os._exit ends the run in time.
    """
    try:
        log_warn("run time budget exhausted; giving up")
        _procs_lock.acquire(timeout=2)
        for proc in list(_active_procs):
            kill_process_tree(proc)
        emit_record(_fallback_record(
            "Quota unavailable",
            "The Antigravity usage collector ran out of time (slow network, DNS "
            "or agy); it tries again on the next refresh.",
        ), wait=2)
        sys.stdout.flush()
        sys.stderr.flush()
    finally:
        # Whatever failed above, the run ends here and now.
        os._exit(0)


def get_cached_limits(max_age_seconds=CACHE_TTL_SECONDS, path=None):
    data, st = read_private_json(path or CACHE_FILE)
    if not isinstance(data, dict):
        return None
    if time.time() - st.st_mtime > max_age_seconds:
        return None
    return data


def _valid_limits(value):
    """``value`` when it is a list of limit records as this collector writes them.

    Anything else is ``None``, i.e. a cache miss: a cached record of the wrong
    shape would otherwise crash every run for the cache's lifetime, or reach
    the panel as it is.
    """
    if not isinstance(value, list) or len(value) > MAX_LIMIT_ENTRIES:
        return None
    for item in value:
        if not isinstance(item, dict):
            return None
        for key, limit in (
            ("title", MAX_LIMIT_TITLE_CHARS),
            ("label", MAX_LIMIT_NAME_CHARS),
            ("resetsAt", MAX_RESET_TEXT_CHARS),
        ):
            text = item.get(key, "")
            if not isinstance(text, str) or len(text) > limit or _CONTROL_CHARS.search(text):
                return None
        percent = item.get("percent")
        if isinstance(percent, bool) or not isinstance(percent, (int, float)) \
                or not 0 <= percent <= 1:
            return None
    return value


def _fetch_email(access_token):
    try:
        req = urllib.request.Request(
            "https://www.googleapis.com/oauth2/v2/userinfo",
            headers={"Authorization": f"Bearer {access_token}"},
        )
        info = fetch_json(
            req,
            timeout=5,
            max_bytes=USERINFO_RESPONSE_MAX_BYTES,
            error_label="Google userinfo request failed",
        )
        email = info.get("email") if isinstance(info, dict) else None
        return email if isinstance(email, str) else ""
    except Exception as e:
        log_debug(f"userinfo lookup failed: {e}")
        return ""


def _fetch_tier(access_token):
    """The account's plan name, e.g. "Google AI Pro", as agy's backend reports it."""
    try:
        req = urllib.request.Request(
            f"{CODE_ASSIST_ENDPOINT}:loadCodeAssist",
            data=json.dumps({"metadata": {"ideType": "ANTIGRAVITY"}}).encode("utf-8"),
            headers={
                "Authorization": f"Bearer {access_token}",
                "Content-Type": "application/json",
                "User-Agent": "antigravity",
            },
            method="POST",
        )
        info = fetch_json(
            req,
            timeout=5,
            max_bytes=CODE_ASSIST_RESPONSE_MAX_BYTES,
            error_label="loadCodeAssist request failed",
        )
    except Exception as e:
        log_debug(f"tier lookup failed: {e}")
        return ""
    if not isinstance(info, dict):
        return ""
    for key in ("paidTier", "currentTier"):
        tier = info.get(key)
        name = tier.get("name") if isinstance(tier, dict) else None
        if isinstance(name, str) and name.strip():
            return name.strip()
    return ""


def resolve_account(account, get_access_token):
    """Return ``(email, tier)`` for the signed-in account.

    Cached per account fingerprint, so switching accounts in agy is picked up
    instead of showing the previous account forever. The network is only hit
    on a cache miss, and only then is an access token minted.
    """
    if not account:
        return "", ""
    cached, _ = read_private_json(ACCOUNT_CACHE_FILE)
    if isinstance(cached, dict) and cached.get("account") == account:
        email, tier = cached.get("email"), cached.get("tier") or ""
        if isinstance(email, str) and isinstance(tier, str):
            return email, tier
    access_token = get_access_token()
    if not access_token:
        return "", ""
    email = _fetch_email(access_token)
    tier = _fetch_tier(access_token)
    # An empty answer is a failed lookup, not an account without an email;
    # caching it would hide the email until the next account switch.
    if email:
        save_private_json(ACCOUNT_CACHE_FILE, {"account": account, "email": email, "tier": tier})
    return email, tier


def _used_fraction(remaining):
    return round(max(0.0, min(1.0, 1.0 - remaining)), 4)


def _finite_number(value):
    """A JSON number as a finite float; ``None`` for anything else (bools too).

    float() of a huge integer overflows, and NaN/Infinity parse as JSON in
    Python: neither may reach arithmetic or the record.
    """
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    try:
        value = float(value)
    except OverflowError:
        return None
    return value if math.isfinite(value) else None


def _group_display(group_name):
    """Map a quota group to its short display name and sort priority.

    Only the two shared pools get short names. Any other group, such as a
    per-model pool like "Gemini 4 Argon", keeps its own name so it never
    collides with, and silently overwrites, the shared Gemini meter.
    """
    name = (group_name or "").strip()
    upper = name.upper()
    if upper.startswith("GEMINI") and "MODEL" in upper:
        return "Gemini", 0
    if "CLAUDE" in upper or "GPT" in upper:
        return "Claude/GPT", 1
    return name, 2


def _limit_entry(group_name, window, bucket_name, used_pct, reset_time):
    """Classify one quota bucket into an ordered, display-ready limit record.

    Shared by the authoritative API parser and the ``agy -p /usage`` reader so
    both express identical group/window precedence. Names are cut to
    MAX_LIMIT_NAME_CHARS before the title is built from them, so the group
    can still be read back from the title.
    """
    group_name = _text_field(group_name, MAX_LIMIT_NAME_CHARS)
    bucket_name = _text_field(bucket_name, MAX_LIMIT_NAME_CHARS)
    bucket = bucket_name.upper()
    win = _text_field(window, MAX_LIMIT_NAME_CHARS).upper()
    prefix, group_priority = _group_display(group_name)

    if win in ("5H", "FIVE HOUR") or "FIVE HOUR" in bucket or "5-HOUR" in bucket:
        title, label, window_priority = f"{prefix} (5h)", "Session", 0
    elif win == "WEEKLY" or "WEEKLY" in bucket:
        title, label, window_priority = f"{prefix} (Weekly)", "Weekly", 1
    else:
        title, label, window_priority = f"{prefix} ({bucket_name})", bucket_name, 2

    return (group_priority, window_priority, {
        "title": title,
        "label": label,
        "percent": used_pct,
        "resetsAt": _text_field(reset_time, MAX_RESET_TEXT_CHARS),
    })


def _finalize_limits(parsed_items):
    """Display order, first MAX_LIMIT_ENTRIES only.

    ``heapq.nsmallest`` is a stable sort cut short; fed a generator, it never
    holds more than that many records, however many buckets came in.
    """
    first = heapq.nsmallest(MAX_LIMIT_ENTRIES, parsed_items, key=lambda x: (x[0], x[1]))
    return [item[2] for item in first]


def limit_group(limit):
    """Display group of a limit record, read back from its title ("Gemini (5h)")."""
    title = str(limit.get("title", "")) if isinstance(limit, dict) else ""
    return title.rsplit(" (", 1)[0] if " (" in title else title


def _limit_sort_key(limit):
    """Same order as :func:`_finalize_limits`, for records already titled."""
    group = limit_group(limit)
    group_priority = SHARED_LIMIT_GROUPS.index(group) if group in SHARED_LIMIT_GROUPS else 2
    window_priority = {"Session": 0, "Weekly": 1}.get(limit.get("label"), 2)
    return group_priority, window_priority


def _retryable(error):
    if isinstance(error, BoundedReadError) or getattr(error, "retryable", True) is False:
        # An oversized response or a request that cannot be built is
        # deterministic: retrying cannot help.
        return False
    status = getattr(error, "status", None)
    return not (status and 400 <= status < 500 and status not in RETRYABLE_CLIENT_STATUSES)


def fetch_authoritative_limits(access_token):
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "User-Agent": "antigravity"
    }
    payload = json.dumps({"project": "default-cli-project"}).encode("utf-8")

    last_err = None
    data = None
    for attempt in range(MAX_RETRIES + 1):
        try:
            req = urllib.request.Request(QUOTA_ENDPOINT, data=payload, headers=headers, method="POST")
            data = fetch_json(
                req,
                timeout=10,
                max_bytes=QUOTA_RESPONSE_MAX_BYTES,
                error_label="quota request failed",
            )
            break
        except Exception as e:
            # A 401/403 or an oversized body will not change on a second try.
            if not _retryable(e):
                raise
            last_err = e
            if attempt < MAX_RETRIES and remaining_budget(RETRY_DELAY_SECONDS + 1) > RETRY_DELAY_SECONDS:
                time.sleep(RETRY_DELAY_SECONDS)

    if not isinstance(data, dict):
        raise last_err or HttpFetchError("quota request failed: unexpected response shape")

    def entries():
        for group in _list_field(data, "groups"):
            if not isinstance(group, dict):
                continue
            for b in _list_field(group, "buckets"):
                if not isinstance(b, dict):
                    continue
                remaining = _finite_number(b.get("remainingFraction", 1.0))
                if remaining is None:
                    continue
                yield _limit_entry(
                    group.get("displayName", ""),
                    b.get("window", ""),
                    b.get("displayName", ""),
                    _used_fraction(remaining),
                    b.get("resetTime", ""),
                )

    return _finalize_limits(entries())


def _list_field(doc, key):
    value = doc.get(key)
    return value if isinstance(value, list) else []


def _parse_agy_usage_text(text):
    """Parse the ``/usage`` table (group, bucket, remaining %, reset time).

    Rows are matched by shape rather than by known group names so a pool the
    CLI adds later still reaches the panel. Returns finalized limits.
    """
    def entries():
        for line in text.splitlines():
            fields = re.split(r"\t+|\s{2,}", line.strip())
            if len(fields) != 4:
                continue
            group, bucket, pct, reset = fields
            m = re.fullmatch(r"(\d{1,3})%", pct)
            if not m:
                continue
            yield _limit_entry(group, "", bucket, _used_fraction(int(m.group(1)) / 100.0), reset)

    return _finalize_limits(entries())


def _parse_agy_usage_json(raw):
    """Parse ``agy -p /usage --output-format json`` into finalized limits.

    Returns ``None`` when ``raw`` is not JSON at all so the caller can read it
    as the plain table an older CLI prints.
    """
    try:
        doc = json.loads(raw)
    except (ValueError, RecursionError):
        return None
    if not isinstance(doc, dict):
        return None
    command = doc.get("command")
    data = command.get("data") if isinstance(command, dict) else None
    groups = data.get("groups") if isinstance(data, dict) else None
    if not isinstance(groups, list):
        response = doc.get("response")
        return _parse_agy_usage_text(response if isinstance(response, str) else "")

    def entries():
        for group in groups:
            if not isinstance(group, dict):
                continue
            for b in _list_field(group, "buckets"):
                if not isinstance(b, dict) or b.get("disabled"):
                    continue
                remaining = _finite_number(b.get("remaining_fraction"))
                if remaining is None:
                    log_debug(f"skipping bucket without remaining_fraction: {b.get('id')}")
                    continue
                yield _limit_entry(
                    group.get("name", ""),
                    b.get("window", ""),
                    b.get("name", ""),
                    _used_fraction(remaining),
                    b.get("reset_time", ""),
                )

    return _finalize_limits(entries())


def fetch_limits_via_agy():
    """Read quota through the official CLI's ``/usage`` command.

    Its structured output carries every pool the CLI shows, including the
    Gemini ones the quota API stopped returning. Each call starts the user's
    MCP servers, so callers go through :func:`get_agy_limits` and its cache.
    Raises :class:`HelperTimeout` when agy was cut short (or never started)
    for lack of time, which says nothing about agy itself.
    """
    agy = resolve_tool("agy")
    if agy is None:
        return None
    try:
        # --log-file keeps these background probes from rotating the user's
        # own session logs out of ~/.gemini/antigravity-cli/log.
        code, stdout_bytes, truncated = run_bounded_stdout(
            [agy, "--log-file", os.devnull, "-p", "/usage", "--output-format", "json"],
            timeout=AGY_USAGE_TIMEOUT_SECONDS,
        )
        if truncated == "time":
            raise HelperTimeout("agy -p /usage did not answer within the run's time budget")
        if truncated:
            log_warn("agy -p /usage output exceeded its size limit or was held open")
            return None
        if code != 0:
            log_debug(f"agy -p /usage exited with {code}")
            return None
        raw = stdout_bytes.decode("utf-8", errors="replace").strip()
        limits = _parse_agy_usage_json(raw)
        if limits is None:
            limits = _parse_agy_usage_text(raw)
        if limits:
            return limits
    except HelperTimeout:
        raise
    except Exception as e:
        log_warn(f"agy -p /usage error: {e}")
    return None


def get_agy_limits(force=False):
    """agy's /usage answer, reused for AGY_USAGE_TTL_SECONDS unless forced.

    Returns ``(limits, timed_out)``. A failed call (non-zero exit, unusable
    output) is cached too: an agy that cannot answer would otherwise be
    relaunched, MCP servers and all, on every refresh. Running out of time is
    not an answer, though: cached, it would hide the pools only agy reports,
    and raise a false "Usage incomplete", for the whole TTL.
    """
    if not force:
        cached = get_cached_limits(AGY_USAGE_TTL_SECONDS, AGY_CACHE_FILE)
        if cached is not None and "limits" in cached:
            limits = cached["limits"]
            # Anything but a failure marker or well-formed limits is a miss.
            if limits is None or _valid_limits(limits) is not None:
                log_debug("agy usage cache hit")
                return limits, False
    try:
        limits = fetch_limits_via_agy()
    except HelperTimeout as e:
        log_warn(str(e))
        return None, True
    save_private_json(AGY_CACHE_FILE, {"limits": limits, "fetchedAt": time.time()})
    return limits, False


def count_dir_entries(directory, limit=10000):
    """Count entries in a directory with a hard cap, tolerating unreadable dirs."""
    count = 0
    try:
        with os.scandir(directory) as entries:
            for _ in entries:
                count += 1
                if count >= limit:
                    break
    except OSError:
        return 0
    return count


def _history_cache_key(history_file):
    """Return a (mtime_ns, size) cache key, or None when the file is unusable."""
    try:
        st = os.lstat(history_file)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode):
        return None
    if st.st_uid != os.getuid() or st.st_size > MAX_HISTORY_FILE_SIZE:
        return None
    return [st.st_mtime_ns, st.st_size]


def _scan_history(history_file, today_str, recent_days_map):
    """Stream history.jsonl; returns (total prompts, today's prompts, today's sessions).

    Sessions are today's distinct conversation ids. Prompts logged without one
    (agy writes a few) count together as a single extra session, so the number
    never exceeds the prompts behind it.
    """
    total_prompts = 0
    today_prompts = 0
    today_conversations = set()
    today_without_id = False
    fd = None
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(history_file, flags)
        st = os.fstat(fd)
        if (
            stat.S_ISREG(st.st_mode)
            and st.st_uid == os.getuid()
            and st.st_size <= MAX_HISTORY_FILE_SIZE
        ):
            with os.fdopen(fd, "r", encoding="utf-8", errors="ignore") as f:
                fd = None
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        data = json.loads(line)
                        ts = data.get("timestamp", 0)
                        if ts > 1e11:
                            ts = ts / 1000.0
                        dt = datetime.fromtimestamp(ts).astimezone()
                        d_str = dt.strftime("%Y-%m-%d")
                        total_prompts += 1
                        if d_str == today_str:
                            today_prompts += 1
                            conversation = data.get("conversationId")
                            if isinstance(conversation, str) and conversation:
                                today_conversations.add(conversation)
                            else:
                                today_without_id = True
                        if d_str in recent_days_map:
                            recent_days_map[d_str] += 1
                    except Exception:
                        continue
    except OSError:
        pass
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    return total_prompts, today_prompts, len(today_conversations) + int(today_without_id)


def _is_count(value):
    # Never more than one prompt per byte of the history file.
    return isinstance(value, int) and not isinstance(value, bool) \
        and 0 <= value <= MAX_HISTORY_FILE_SIZE


def _valid_history_cache(cached, key):
    """True when ``cached`` is the aggregation for ``key``, shaped as written.

    Anything else is a miss and the history is rescanned, instead of crashing
    every run until the history file or the day changes.
    """
    if not isinstance(cached, dict) or cached.get("historyKey") != key:
        return False
    if not all(_is_count(cached.get(k)) for k in ("totalPrompts", "todayPrompts", "todaySessions")):
        return False
    days = cached.get("recentDays")
    return isinstance(days, list) and len(days) <= 7 and all(
        isinstance(day, dict) and isinstance(day.get("date"), str)
        and _is_count(day.get("messageCount"))
        for day in days
    )


def collect_local_stats():
    now = datetime.now().astimezone()
    today_str = now.strftime("%Y-%m-%d")

    recent_days_map = {}
    for i in range(7):
        d = (now - timedelta(days=6-i)).strftime("%Y-%m-%d")
        recent_days_map[d] = 0

    history_file = HISTORY_FILE
    brain_dir = BRAIN_DIR

    total_prompts = 0
    today_prompts = 0
    today_sessions = 0

    # Cache the history scan when the file is unchanged and the local day has
    # not rolled over; the cache key is validated through the private reader.
    history_key = _history_cache_key(history_file)
    cached, _ = read_private_json(HISTORY_CACHE_FILE)
    cache_hit = False
    if history_key is not None and _valid_history_cache(cached, history_key + [today_str]):
        total_prompts = cached["totalPrompts"]
        today_prompts = cached["todayPrompts"]
        today_sessions = cached["todaySessions"]
        for day in cached["recentDays"]:
            if day["date"] in recent_days_map:
                recent_days_map[day["date"]] = day["messageCount"]
        cache_hit = True
        log_debug(f"history cache hit ({history_key[1]} bytes)")

    if not cache_hit:
        total_prompts, today_prompts, today_sessions = _scan_history(
            history_file, today_str, recent_days_map
        )
        if history_key is not None:
            save_private_json(HISTORY_CACHE_FILE, {
                "historyKey": history_key + [today_str],
                "totalPrompts": total_prompts,
                "todayPrompts": today_prompts,
                "todaySessions": today_sessions,
                "recentDays": [
                    {"date": k, "messageCount": v} for k, v in recent_days_map.items()
                ],
            })
        log_debug(f"history scanned ({history_key[1] if history_key else 0} bytes)")

    recent_days = [{"date": k, "messageCount": v} for k, v in recent_days_map.items()]
    active_dates = [k for k, v in recent_days_map.items() if v > 0]
    total_sessions = count_dir_entries(brain_dir) if os.path.isdir(brain_dir) else 1

    return {
        "todayPrompts": today_prompts,
        "todaySessions": today_sessions,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": recent_days,
        "totalPrompts": total_prompts,
        "totalSessions": total_sessions,
        "activeDays": len(active_dates),
        "activeDates": active_dates,
        "modelUsage": {}
    }


def _resolve_limits(get_token, force, status_text, auth_help):
    """Combine the quota API with agy's /usage into one list of limits.

    The API is cheap and stays the source for every pool it reports. agy is
    consulted, through its long-lived cache, only when the API leaves out a
    shared pool or one seen recently, e.g. the Gemini pools it stopped
    returning and per-model pools such as "Gemini 4 Argon".
    """
    access_token, token_err = get_token()
    api_limits, api_error = None, None
    if access_token:
        try:
            api_limits = fetch_authoritative_limits(access_token)
        except Exception as e:
            api_error = e
            log_warn(f"failed to fetch quota after retries: {e}")

    have = {limit_group(item) for item in api_limits or []}
    wanted = set(SHARED_LIMIT_GROUPS) | known_limit_groups()
    agy_limits, agy_timed_out = None, False
    if api_limits is None or not wanted <= have:
        agy_limits, agy_timed_out = get_agy_limits(force)

    if api_limits is None and agy_limits is None:
        if not status_text and access_token:
            status_text = "Quota unavailable"
            auth_help = f"Failed to retrieve quota: {api_error}"
        elif not status_text:
            status_text = "Waiting for auth"
            auth_help = token_err or "Run `agy` to authenticate with Antigravity."
        return None, status_text, auth_help

    merged = list(api_limits or [])
    merged += [item for item in agy_limits or [] if limit_group(item) not in have]
    limits = sorted(merged, key=_limit_sort_key)[:MAX_LIMIT_ENTRIES]
    # Without agy's pools only for lack of time, the merge is not cached
    # either: the next run asks again instead of reporting them missing.
    if not agy_timed_out:
        save_private_json(CACHE_FILE, {"limits": limits, "fetchedAt": time.time()})
    return limits, status_text, auth_help


def _read_seen_groups():
    """Pools seen recently, as ``{group: last seen}``; malformed entries skipped.

    A file holding more groups than limits can name is not this collector's
    and is ignored as a whole.
    """
    seen, _ = read_private_json(GROUPS_STATE_FILE)
    if not isinstance(seen, dict) or len(seen) > MAX_TRACKED_GROUPS:
        return {}
    groups = {}
    for group, ts in seen.items():
        if len(group) > MAX_LIMIT_NAME_CHARS or _CONTROL_CHARS.search(group):
            continue
        ts = _finite_number(ts)
        if ts is not None:
            groups[group] = ts
    return groups


def known_limit_groups(now=None):
    """Pools reported within GROUP_MEMORY_SECONDS."""
    now = time.time() if now is None else now
    return {g for g, ts in _read_seen_groups().items() if now - ts <= GROUP_MEMORY_SECONDS}


def track_limit_groups(limits, now=None):
    """Remember the pools in ``limits``; return recently seen ones now missing.

    Timestamps are only rewritten when they are an hour old, so a steady state
    does not cost a disk write per refresh.
    """
    now = time.time() if now is None else now
    seen = _read_seen_groups()
    current = {limit_group(item) for item in limits or []} - {""}
    missing = sorted(
        g for g, ts in seen.items() if g not in current and now - ts <= GROUP_MEMORY_SECONDS
    )
    updated = {g: ts for g, ts in seen.items() if now - ts <= GROUP_MEMORY_SECONDS}
    for group in current:
        if now - updated.get(group, 0) > GROUP_SEEN_REFRESH_SECONDS:
            updated[group] = now
    if updated != seen:
        save_private_json(GROUPS_STATE_FILE, updated)
    return missing


def _check_limits_complete(limits, status_text, auth_help):
    """Flag a quota response that dropped a pool it reported recently.

    Without this an upstream format change only shows up as a meter quietly
    vanishing from the panel. Pools are compared against what this account
    reported over the last week rather than a fixed list, so a plan without
    one of the shared pools is not flagged forever.
    """
    if status_text:
        return status_text, auth_help
    missing = track_limit_groups(limits)
    if limits and not missing:
        return status_text, auth_help
    what = f"the {' and '.join(missing)} quota" if missing else "any quota"
    log_warn(f"quota response is missing {what}")
    return "Usage incomplete", (
        f"Antigravity stopped reporting {what}, so its usage format may have "
        "changed. Compare with /usage in agy."
    )


def notify_status_change(status_text, detail):
    """Raise one desktop notification when the usage status turns into a problem.

    A problem notifies on its second consecutive sighting, so one network blip
    stays quiet; it then stays quiet until the status changes, and recovering
    re-arms the alert.
    """
    status_text = clean_text(status_text or "", MAX_LIMIT_NAME_CHARS)
    detail = clean_text(detail or "", MAX_MESSAGE_CHARS)
    state, _ = read_private_json(ALERT_STATE_FILE)
    state = state if isinstance(state, dict) else {}
    if state.get("status", "") != status_text:
        save_private_json(ALERT_STATE_FILE, {"status": status_text, "notified": False})
        return
    if not status_text or state.get("notified"):
        return
    timeout = remaining_budget(5)
    if timeout <= 0:
        # Left armed: the next run, with time to spare, sends it.
        log_warn("no time left to send the desktop notification")
        return
    save_private_json(ALERT_STATE_FILE, {"status": status_text, "notified": True})
    notify_send = resolve_tool("notify-send")
    if notify_send is None:
        return
    try:
        # Notification daemons such as mako render the body as Pango markup.
        subprocess.run(
            [
                notify_send, "--app-name=Antigravity",
                f"Antigravity: {status_text}", html.escape(detail, quote=False),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=timeout,
        )
    except Exception as e:
        log_warn(f"failed to send desktop notification: {e}")


def _build_record(email, tier, status_text, auth_help, limits, local_stats):
    """Assemble the display-ready usage record emitted on stdout.

    Every text field is cleaned and capped here, since it carries server
    error bodies, exception text and cached values to the panel.
    """
    tier = clean_text(tier or "", MAX_LIMIT_NAME_CHARS)
    email = clean_text(email or "", 254)
    status_text = clean_text(status_text or "", MAX_LIMIT_NAME_CHARS)
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": True,
        "tierLabel": " · ".join(part for part in (tier, email) if part),
        "usageStatusText": status_text,
        "authHelpText": clean_text(auth_help or "", MAX_MESSAGE_CHARS),
        # Only an auth problem gets the panel's Sign In button; signing in
        # again cannot fix an outage or a changed usage format.
        "authRequired": status_text == "Waiting for auth",
        "limits": limits or [],
        # history.jsonl counts prompts, while other agents' recentDays count
        # tokens; the panel labels the chart from this.
        "recentDaysUnit": "prompts",
    }
    record.update(local_stats)
    return record


def _fallback_record(status_text, detail):
    """Last-resort record so a crash or a stuck run shows up in the panel.

    Without it the updater keeps the previous record and the panel silently
    freezes on stale numbers. The last limits are kept for context.
    """
    limits = []
    try:
        cached, _ = read_private_json(CACHE_FILE)
        if isinstance(cached, dict):
            limits = _valid_limits(cached.get("limits")) or []
    except Exception:
        pass
    return _build_record("", "", status_text, detail, limits, {})


def _error_record(error):
    return _fallback_record("Collector error", f"The Antigravity usage collector failed: {error}")


def _run(args):
    # When not forced and an existing state file already exists, only query remote servers
    # if there is at least one active 'agy' session running on the machine.
    if not args.force and os.path.exists(STATE_FILE) and not is_agy_running():
        # The normal idle path, hit on every bar tick: the updater forwards
        # stderr to the shell log, so this stays a debug line.
        log_debug("no active agy session running; skipping update")
        return

    limits = None
    status_text = ""
    auth_help = ""

    if resolve_tool("agy") is None:
        status_text = "Not installed"
        auth_help = "Antigravity CLI ('agy') is not found in PATH."

    token, cred_err = read_token()
    account = account_id(token)
    token_state = {}

    def get_token():
        # Most runs are served from caches; mint a token only when one is used.
        if "result" not in token_state:
            token_state["result"] = get_valid_access_token(token, cred_err)
            log_debug(f"access token resolved: {'yes' if token_state['result'][0] else 'no'}")
        return token_state["result"]

    if not args.force:
        ttl = CACHE_TTL_SECONDS * 2 if args.limits_only else CACHE_TTL_SECONDS
        cached = get_cached_limits(ttl)
        limits = _valid_limits(cached.get("limits")) if cached else None
        if limits is not None:
            log_debug("limits cache hit")

    if limits is None:
        limits, status_text, auth_help = _resolve_limits(
            get_token, args.force, status_text, auth_help
        )
    status_text, auth_help = _check_limits_complete(limits, status_text, auth_help)
    notify_status_change(status_text, auth_help)
    email, tier = resolve_account(account, lambda: get_token()[0])

    record = _build_record(email, tier, status_text, auth_help, limits, collect_local_stats())
    emit_record(record)


def main(argv=None):
    global _record_emitted
    parser = argparse.ArgumentParser(description="Collect Antigravity usage record")
    parser.add_argument("--force", action="store_true", help="Bypass probe cache and active session check")
    parser.add_argument("--limits-only", action="store_true", help="Prioritize speed/cache")
    parser.add_argument("--debug", action="store_true", help="Print verbose diagnostics to stderr")
    args = parser.parse_args(argv)

    if args.debug:
        os.environ["OMARCHY_ANTIGRAVITY_DEBUG"] = "1"
    log_debug(f"start force={args.force} limits_only={args.limits_only}")
    start_run_budget()
    _record_emitted = False
    watchdog = start_watchdog(RUN_BUDGET_SECONDS + WATCHDOG_GRACE_SECONDS)

    lock_fd = None
    try:
        lock_fd = acquire_run_lock()
        if lock_fd is None:
            # Exit 0 with no output: the updater keeps the record the other
            # run is about to write.
            log_warn("another collector run is still in progress; skipping")
            return 0
        _run(args)
    except Exception as e:
        log_warn(f"collector error: {e!r}")
        try:
            notify_status_change("Collector error", str(e))
        except Exception:
            pass
        emit_record(_error_record(e))
    finally:
        watchdog.set()
        if lock_fd is not None:
            os.close(lock_fd)
    return 0


RUN_LOCK_WAIT_SECONDS = 15


def acquire_run_lock():
    """Take the collector's run lock; ``None`` when another run keeps it.

    Waits a little (another run usually finishes within seconds) but never so
    long that this run could not finish inside the updater's timeout. The lock
    file is opened like every other private file: no symlinks, owner only.
    A cache directory that cannot be made private raises, so the run reports
    it as a collector error rather than as another run in progress.
    """
    ensure_dir(CACHE_DIR)
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    fd = os.open(RUN_LOCK_FILE, flags, 0o600)
    deadline = time.monotonic() + RUN_LOCK_WAIT_SECONDS
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except BlockingIOError:
            if time.monotonic() >= deadline:
                os.close(fd)
                return None
            time.sleep(0.1)


if __name__ == "__main__":
    install_signal_handlers()
    sys.exit(main())
