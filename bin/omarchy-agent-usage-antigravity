STATE_FILE = os.path.join(STATE_DIR, "antigravity.json")
CACHE_TTL_SECONDS = 30
TOKEN_FILE = os.path.expanduser("~/.gemini/antigravity-cli/antigravity-oauth-token")
MAX_TOKEN_FILE_SIZE = 64 * 1024
MAX_CACHE_FILE_SIZE = 1024 * 1024
MAX_HISTORY_FILE_SIZE = 16 * 1024 * 1024
MAX_SUBPROCESS_OUTPUT_BYTES = 512 * 1024
MAX_RETRIES = 2
RETRY_DELAY_SECONDS = 2

# Conservative per-endpoint ceilings for remote response bodies. These bound how
# much memory a compromised or misbehaving endpoint can make the collector
# allocate before the body is rejected.
OAUTH_TOKEN_RESPONSE_MAX_BYTES = 16 * 1024
USERINFO_RESPONSE_MAX_BYTES = 16 * 1024
QUOTA_RESPONSE_MAX_BYTES = 256 * 1024
HTTP_ERROR_BODY_MAX_BYTES = 4 * 1024


class BoundedReadError(Exception):
    """Raised when a remote HTTP response exceeds its byte ceiling."""


class HttpFetchError(Exception):
    """Raised when a remote HTTP request fails or returns an invalid body."""


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Refuse HTTP redirects so credential-bearing requests are never replayed."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(
            req.full_url, code, f"refusing redirect to {newurl}", headers, fp
        )


# Refuse redirects process-wide: a redirect could replay the OAuth client secret
# and refresh token (or a quota bearer token) to an attacker-chosen host.
urllib.request.install_opener(urllib.request.build_opener(_NoRedirectHandler))


def read_bounded(resp, max_bytes):
    """Read at most ``max_bytes`` bytes from an HTTP response body.

    Content-Length is checked when the server provides it and, regardless of
    what the server claims, no more than ``max_bytes`` + 1 bytes are ever read
    so an oversized or continuously delivered response cannot force unbounded
    allocation. Raises :class:`BoundedReadError` when the body is too large.
    """
    limit = max(1, int(max_bytes))

    headers = getattr(resp, "headers", None)
    if headers is not None:
        declared = None
        try:
            declared = headers.get("Content-Length")
        except Exception:
            declared = None
        if declared is not None:
            try:
                declared_length = int(declared)
            except (TypeError, ValueError):
                declared_length = None
            if declared_length is not None and declared_length > limit:
                raise BoundedReadError(
                    f"HTTP response Content-Length {declared_length} exceeds limit of {limit} bytes"
                )

    chunks = []
    remaining = limit + 1
    while remaining > 0:
        chunk = resp.read(min(65536, remaining))
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)

    body = b"".join(chunks)
    if len(body) > limit:
        raise BoundedReadError(f"HTTP response body exceeds limit of {limit} bytes")
    return body


def fetch_json(req, timeout, max_bytes, error_label):
    """Perform an HTTP request and parse a bounded JSON response.

    Both success bodies and HTTPError bodies are read through
    :func:`read_bounded` so every response and error path is size-limited.
    """
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = read_bounded(resp, max_bytes)
    except urllib.error.HTTPError as e:
        detail = f"{error_label}: HTTP {e.code} {e.reason}".strip()
        snippet = ""
        try:
            snippet = read_bounded(e, min(max_bytes, HTTP_ERROR_BODY_MAX_BYTES)).decode(
                "utf-8", errors="replace"
            ).strip()
        except Exception:
            snippet = ""
        finally:
            try:
                e.close()
            except Exception:
                pass
        if snippet:
            detail = f"{detail}: {snippet[:512]}"
        raise HttpFetchError(detail) from e

    try:
        return json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as e:
        raise HttpFetchError(f"{error_label}: invalid JSON response") from e


def is_agy_running():
    """Check via OS process table (pgrep) if at least one agy process is active."""
    pgrep = resolve_tool("pgrep")
    if pgrep is None:
        return True
    try:
        res = subprocess.run(
            [pgrep, "-x", "agy"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2
        )
        return res.returncode == 0
    except Exception:
        return True


def ensure_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass


def _trusted_parent_chain(path):
    """True when every ancestor directory of ``path`` is trusted.

    Rejects world-writable directories and directories owned by neither root
    nor the current user, so a binary reached through an attacker-writable
    directory cannot be trusted even if its immediate parent looks safe.
    """
    current = os.path.dirname(path) or "/"
    uid = os.getuid()
    while True:
        try:
            st = os.stat(current)
        except OSError:
            return False
        if not stat.S_ISDIR(st.st_mode):
            return False
        if st.st_mode & 0o002:
            return False
        if st.st_uid not in (0, uid):
            return False
        parent = os.path.dirname(current)
        if parent == current:
            return True
        current = parent


def resolve_tool(name):
    """Resolve an external helper to an absolute path in a trusted directory.

    ``shutil.which`` honours ``PATH``; a poisoned ``PATH`` entry could otherwise
    substitute an attacker-controlled ``agy`` or ``secret-tool``. Reject
    candidates that are not executable regular files or whose parent chain
    contains a world-writable directory or a directory owned by neither root
    nor this user. Returns the resolved path, or ``None`` when nothing trusted
    is found.
    """
    path = shutil.which(name)
    if not path:
        return None
    try:
        path = os.path.realpath(path)
        st = os.stat(path)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode) or not os.access(path, os.X_OK):
        return None
    if not _trusted_parent_chain(path):
        return None
    return path


def get_token_from_file():
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(TOKEN_FILE, flags)
    except FileNotFoundError:
        return None, f"Token file not found: {TOKEN_FILE}"
    except OSError as e:
        return None, f"Failed to open token file: {e}"

    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, f"Token file is not a regular file: {TOKEN_FILE}"
        if st.st_uid != os.getuid():
            return None, f"Token file owner mismatch (uid {st.st_uid} != {os.getuid()}): {TOKEN_FILE}"
        if (st.st_mode & 0o077) != 0:
            return None, f"Token file has insecure permissions ({oct(st.st_mode & 0o777)}), must be private to owner (0600)"
        if st.st_size > MAX_TOKEN_FILE_SIZE:
            return None, f"Token file exceeds maximum allowed size ({st.st_size} > {MAX_TOKEN_FILE_SIZE} bytes)"

        raw = os.read(fd, MAX_TOKEN_FILE_SIZE + 1)
        if len(raw) > MAX_TOKEN_FILE_SIZE:
            return None, f"Token file content exceeds maximum allowed size of {MAX_TOKEN_FILE_SIZE} bytes"

        data = json.loads(raw.decode("utf-8"))
        if not data or not isinstance(data, dict) or "token" not in data:
            return None, "Invalid token structure in token file"
        return data, ""
    except Exception as e:
        return None, f"Failed to read token file: {e}"
    finally:
        os.close(fd)


def get_token_from_keyring():
    secret_tool = resolve_tool("secret-tool")
    if secret_tool is None:
        return None, "secret-tool is not available in a trusted PATH"
    try:
        code, raw_bytes, truncated = run_bounded_stdout(
            [secret_tool, "lookup", "service", "gemini", "username", "antigravity"],
            timeout=5,
        )
        if truncated:
            return None, "Keyring credential exceeds maximum allowed size"
        if code != 0:
            return None, "No Antigravity credentials found in keyring"
        raw = raw_bytes.decode("utf-8", errors="ignore").strip()
        if not raw:
            return None, "No Antigravity credentials found in keyring"
        data = json.loads(raw)
        return data, ""
    except Exception as e:
        return None, f"Failed to read keyring: {e}"


def get_credentials():
    data, err_file = get_token_from_file()
    if data:
        return data, "file", ""

    data, err_keyring = get_token_from_keyring()
    if data:
        return data, "keyring", ""

    return None, None, f"No Antigravity credentials found in token file or keyring ({err_file}; {err_keyring})"


def save_private_json(file_path, data):
    fd = None
    tmp_path = None
    try:
        parent_dir = os.path.dirname(file_path)
        ensure_dir(parent_dir)

        prefix = f".{os.path.basename(file_path)}.tmp."
        fd, tmp_path = tempfile.mkstemp(dir=parent_dir, prefix=prefix)

        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError(f"Temporary file is not a regular file: {tmp_path}")
        if st.st_uid != os.getuid():
            raise OSError(f"Temporary file owner mismatch (uid {st.st_uid} != {os.getuid()})")
        if (st.st_mode & 0o077) != 0:
            raise OSError(f"Temporary file has insecure permissions ({oct(st.st_mode & 0o777)})")

        payload = json.dumps(data, indent=2).encode("utf-8")
        total_written = 0
        while total_written < len(payload):
            written = os.write(fd, payload[total_written:])
            if written == 0:
                raise OSError("Failed to write payload to temporary file")
            total_written += written

        os.fsync(fd)
        os.close(fd)
        fd = None

        os.replace(tmp_path, file_path)
        tmp_path = None
    except Exception as e:
        sys.stderr.write(f"omarchy-agent-usage-antigravity: failed to save private file: {e}\n")
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass


def save_token_to_file(data):
    fd = None
    tmp_path = None
    try:
        token_dir = os.path.dirname(TOKEN_FILE)
        ensure_dir(token_dir)

        prefix = f".{os.path.basename(TOKEN_FILE)}.tmp."
        fd, tmp_path = tempfile.mkstemp(dir=token_dir, prefix=prefix)

        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError(f"Temporary token file is not a regular file: {tmp_path}")
        if st.st_uid != os.getuid():
            raise OSError(f"Temporary token file owner mismatch (uid {st.st_uid} != {os.getuid()})")
        if (st.st_mode & 0o077) != 0:
            raise OSError(f"Temporary token file has insecure permissions ({oct(st.st_mode & 0o777)})")

        payload = json.dumps(data, indent=2).encode("utf-8")
        if len(payload) > MAX_TOKEN_FILE_SIZE:
            raise ValueError(f"Token payload exceeds maximum allowed size ({len(payload)} > {MAX_TOKEN_FILE_SIZE} bytes)")

        total_written = 0
        while total_written < len(payload):
            written = os.write(fd, payload[total_written:])
            if written == 0:
                raise OSError("Failed to write token payload to temporary file")
            total_written += written

        os.fsync(fd)
        os.close(fd)
        fd = None

        os.replace(tmp_path, TOKEN_FILE)
        tmp_path = None
    except Exception as e:
        sys.stderr.write(f"omarchy-agent-usage-antigravity: failed to save token file: {e}\n")
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass


def save_token_to_keyring(data):
    secret_tool = resolve_tool("secret-tool")
    if secret_tool is None:
        sys.stderr.write("omarchy-agent-usage-antigravity: secret-tool is not available in a trusted PATH\n")
        return
    try:
        p = subprocess.Popen(
            [secret_tool, "store", "--label=Password for 'antigravity' on 'gemini'", "service", "gemini", "username", "antigravity"],
            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        p.communicate(input=json.dumps(data).encode("utf-8"), timeout=5)
    except Exception as e:
        sys.stderr.write(f"omarchy-agent-usage-antigravity: failed to save keyring: {e}\n")


def get_valid_access_token():
    data, source, err = get_credentials()
    if not data:
        return None, err

    tok = data.get("token", {})
    access_token = tok.get("access_token")
    refresh_token = tok.get("refresh_token")
    expiry_str = tok.get("expiry")

    is_expired = False
    if expiry_str:
        try:
            exp_dt = datetime.fromisoformat(expiry_str)
            now_utc = datetime.now(timezone.utc)
            if (exp_dt - now_utc).total_seconds() < 120:
                is_expired = True
        except Exception:
            pass

    if (not access_token or is_expired) and refresh_token:
        try:
            if STRICT_CLIENT and not (
                os.getenv("ANTIGRAVITY_CLIENT_ID") and os.getenv("ANTIGRAVITY_CLIENT_SECRET")
            ):
                raise RuntimeError(
                    "strict client mode requires ANTIGRAVITY_CLIENT_ID and "
                    "ANTIGRAVITY_CLIENT_SECRET; refusing to use the built-in default"
                )
            params = urllib.parse.urlencode({
                "client_id": OAUTH_CLIENT_ID,
                "client_secret": OAUTH_CLIENT_SECRET,
                "refresh_token": refresh_token,
                "grant_type": "refresh_token"
            }).encode("utf-8")
            req = urllib.request.Request("https://oauth2.googleapis.com/token", data=params, method="POST")
            res = fetch_json(
                req,
                timeout=10,
                max_bytes=OAUTH_TOKEN_RESPONSE_MAX_BYTES,
                error_label="OAuth token refresh failed",
            )
            new_token = res.get("access_token")
            expires_in = res.get("expires_in", 3600)
            if new_token:
                access_token = new_token
                tok["access_token"] = new_token
                new_exp = datetime.now(timezone.utc) + timedelta(seconds=expires_in)
                tok["expiry"] = new_exp.isoformat()
                data["token"] = tok

                if source == "file":
                    save_token_to_file(data)
                elif source == "keyring":
                    save_token_to_keyring(data)
        except Exception as e:
            sys.stderr.write(f"omarchy-agent-usage-antigravity: token refresh error: {e}\n")

    if not access_token:
        return None, "Unable to obtain valid access token"

    return access_token, ""


def read_private_json(file_path, max_bytes=MAX_CACHE_FILE_SIZE):
    """Read a user-owned JSON file through a bounded, no-follow descriptor.

    Rejects symlinks, non-regular files, files owned by another user, and
    payloads larger than ``max_bytes`` before any decoding or parsing happens.
    Returns ``(data, stat_result)`` on success and ``(None, None)`` otherwise.
    """
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(file_path, flags)
    except OSError:
        return None, None

    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, None
        if st.st_uid != os.getuid():
            return None, None
        if st.st_size > max_bytes:
            return None, None
        raw = os.read(fd, max_bytes + 1)
        if len(raw) > max_bytes:
            return None, None
        return json.loads(raw.decode("utf-8")), st
    except Exception:
        return None, None
    finally:
        os.close(fd)


def run_bounded_stdout(args, timeout, max_bytes=MAX_SUBPROCESS_OUTPUT_BYTES):
    """Run a command and capture a bounded amount of stdout.

    Returns ``(returncode, stdout_bytes, truncated)``. The child is killed when
    it produces more than ``max_bytes`` or exceeds ``timeout`` seconds so a
    misbehaving helper cannot force unbounded allocation.
    """
    try:
        proc = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return None, b"", False

    state = {"data": bytearray(), "truncated": False}

    def _reader():
        try:
            while True:
                chunk = proc.stdout.read(65536)
                if not chunk:
                    break
                if len(state["data"]) + len(chunk) > max_bytes:
                    state["truncated"] = True
                    proc.kill()
                    break
                state["data"].extend(chunk)
        except Exception:
            pass

    reader = threading.Thread(target=_reader, daemon=True)
    reader.start()
    try:
        returncode = proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        state["truncated"] = True
        proc.kill()
        returncode = proc.wait()
    reader.join(timeout=2)
    if proc.stdout is not None:
        try:
            proc.stdout.close()
        except OSError:
            pass
    return returncode, bytes(state["data"]), state["truncated"]


def get_cached_limits(max_age_seconds=CACHE_TTL_SECONDS):
    data, st = read_private_json(CACHE_FILE)
    if data is None:
        return None
    if time.time() - st.st_mtime > max_age_seconds:
        return None
    return data


def get_cached_user_email(access_token):
    data, _ = read_private_json(USER_CACHE_FILE)
    if data and data.get("email"):
        return data["email"]

    acc_data, _ = read_private_json(os.path.expanduser("~/.gemini/google_accounts.json"))
    if acc_data:
        active = acc_data.get("active")
        if active and isinstance(active, str):
            return active
        old = acc_data.get("old", [])
        if old and isinstance(old, list) and len(old) > 0:
            return old[0]

    try:
        headers = {"Authorization": f"Bearer {access_token}"}
        req = urllib.request.Request("https://www.googleapis.com/oauth2/v2/userinfo", headers=headers)
        info = fetch_json(
            req,
            timeout=5,
            max_bytes=USERINFO_RESPONSE_MAX_BYTES,
            error_label="Google userinfo request failed",
        )
        email = info.get("email")
        if email:
            save_private_json(USER_CACHE_FILE, {"email": email})
            return email
    except Exception:
        pass

    return ""


def fetch_authoritative_limits(access_token):
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "User-Agent": "antigravity"
    }
    payload = json.dumps({"project": "default-cli-project"}).encode("utf-8")

    last_err = None
    data = None
    for attempt in range(MAX_RETRIES + 1):
        try:
            req = urllib.request.Request(QUOTA_ENDPOINT, data=payload, headers=headers, method="POST")
            data = fetch_json(
                req,
                timeout=10,
                max_bytes=QUOTA_RESPONSE_MAX_BYTES,
                error_label="quota request failed",
            )
            break
        except BoundedReadError:
            # An oversized response is deterministic: retrying cannot help.
            raise
        except Exception as e:
            last_err = e
            if attempt < MAX_RETRIES:
                time.sleep(RETRY_DELAY_SECONDS)

    if data is None:
        raise last_err or RuntimeError("Failed to fetch quota from endpoint")

    groups = data.get("groups", [])
    parsed_items = []
    for group in groups:
        gname = group.get("displayName", "")
        for b in group.get("buckets", []):
            rem = b.get("remainingFraction", 1.0)
            used_pct = round(max(0.0, min(1.0, 1.0 - rem)), 4)
            w = b.get("window", "")
            bname = b.get("displayName", "")
            reset_time = b.get("resetTime", "")

            gname_upper = gname.upper()
            bname_upper = bname.upper()
            w_upper = w.upper()

            if "GEMINI" in gname_upper:
                prefix = "Gemini"
                group_priority = 0
            elif "CLAUDE" in gname_upper or "GPT" in gname_upper:
                prefix = "Claude/GPT"
                group_priority = 1
            else:
                prefix = gname
                group_priority = 2

            if w_upper == "5H" or "FIVE HOUR" in bname_upper or "5-HOUR" in bname_upper:
                title = f"{prefix} (5h)"
                label = "Session"
                window_priority = 0
            elif w_upper == "WEEKLY" or "WEEKLY" in bname_upper:
                title = f"{prefix} (Weekly)"
                label = "Weekly"
                window_priority = 1
            else:
                title = f"{prefix} ({bname})"
                label = bname
                window_priority = 2

            parsed_items.append((
                group_priority,
                window_priority,
                {
                    "title": title,
                    "label": label,
                    "percent": used_pct,
                    "resetsAt": reset_time
                }
            ))

    parsed_items.sort(key=lambda x: (x[0], x[1]))
    limits = [item[2] for item in parsed_items]

    save_private_json(CACHE_FILE, {"limits": limits, "fetchedAt": time.time()})
    return limits


def fetch_limits_via_agy():
    agy = resolve_tool("agy")
    if agy is None:
        return None
    try:
        code, stdout_bytes, truncated = run_bounded_stdout([agy, "-p", "/usage"], timeout=10)
        if truncated:
            sys.stderr.write("omarchy-agent-usage-antigravity: agy -p /usage output exceeded size limit\n")
            return None
        if code != 0:
            return None
        lines = stdout_bytes.decode("utf-8", errors="replace").strip().splitlines()
        parsed_items = []
        for line in lines:
            m = re.search(r'(Gemini Models|Claude and GPT models)\s+(Weekly|Five Hour)\s+Limit Remaining\s+(\d+)%\s+(\S+)', line)
            if m:
                group, window, pct, reset = m.groups()
                rem_frac = int(pct) / 100.0
                used_pct = round(max(0.0, min(1.0, 1.0 - rem_frac)), 4)
                if group == 'Gemini Models':
                    prefix = "Gemini"
                    group_priority = 0
                else:
                    prefix = "Claude/GPT"
                    group_priority = 1

                if window == "Five Hour":
                    label = "Session"
                    title = f"{prefix} (5h)"
                    window_priority = 0
                else:
                    label = "Weekly"
                    title = f"{prefix} (Weekly)"
                    window_priority = 1

                parsed_items.append((group_priority, window_priority, {
                    "title": title,
                    "label": label,
                    "percent": used_pct,
                    "resetsAt": reset
                }))
        if parsed_items:
            parsed_items.sort(key=lambda x: (x[0], x[1]))
            limits = [item[2] for item in parsed_items]
            save_private_json(CACHE_FILE, {"limits": limits, "fetchedAt": time.time()})
            return limits
    except Exception as e:
        sys.stderr.write(f"omarchy-agent-usage-antigravity: agy -p /usage error: {e}\n")
    return None


def count_dir_entries(directory, limit=10000):
    """Count entries in a directory with a hard cap, tolerating unreadable dirs."""
    count = 0
    try:
        with os.scandir(directory) as entries:
            for _ in entries:
                count += 1
                if count >= limit:
                    break
    except OSError:
        return 0
    return count


def collect_local_stats():
    now = datetime.now().astimezone()
    today_str = now.strftime("%Y-%m-%d")

    recent_days_map = {}
    for i in range(7):
        d = (now - timedelta(days=6-i)).strftime("%Y-%m-%d")
        recent_days_map[d] = 0

    history_file = os.path.expanduser("~/.gemini/antigravity-cli/history.jsonl")
    brain_dir = os.path.expanduser("~/.gemini/antigravity-cli/brain")

    total_prompts = 0
    today_prompts = 0

    fd = None
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(history_file, flags)
        st = os.fstat(fd)
        if (
            stat.S_ISREG(st.st_mode)
            and st.st_uid == os.getuid()
            and st.st_size <= MAX_HISTORY_FILE_SIZE
        ):
            with os.fdopen(fd, "r", encoding="utf-8", errors="ignore") as f:
                fd = None
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        data = json.loads(line)
                        ts = data.get("timestamp", 0)
                        if ts > 1e11:
                            ts = ts / 1000.0
                        dt = datetime.fromtimestamp(ts).astimezone()
                        d_str = dt.strftime("%Y-%m-%d")
                        total_prompts += 1
                        if d_str == today_str:
                            today_prompts += 1
                        if d_str in recent_days_map:
                            recent_days_map[d_str] += 1
                    except Exception:
                        continue
    except OSError:
        pass
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass

    recent_days = [{"date": k, "messageCount": v} for k, v in recent_days_map.items()]
    active_dates = [k for k, v in recent_days_map.items() if v > 0]
    total_sessions = count_dir_entries(brain_dir) if os.path.isdir(brain_dir) else 1

    return {
        "todayPrompts": today_prompts,
        "todaySessions": 1 if today_prompts > 0 else 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": recent_days,
        "totalPrompts": total_prompts,
        "totalSessions": total_sessions,
        "activeDays": len(active_dates),
        "activeDates": active_dates,
        "modelUsage": {}
    }


def main(argv=None):
    parser = argparse.ArgumentParser(description="Collect Antigravity usage record")
    parser.add_argument("--force", action="store_true", help="Bypass probe cache and active session check")
    parser.add_argument("--limits-only", action="store_true", help="Prioritize speed/cache")
    args = parser.parse_args(argv)

    # When not forced and an existing state file already exists, only query remote servers
    # if there is at least one active 'agy' session running on the machine.
    if not args.force and os.path.exists(STATE_FILE) and not is_agy_running():
        sys.stderr.write("omarchy-agent-usage-antigravity: no active agy session running; skipping update\n")
        return 0

    limits = None
    email = ""
    status_text = ""
    auth_help = ""

    if resolve_tool("agy") is None:
        status_text = "Not installed"
        auth_help = "Antigravity CLI ('agy') is not found in PATH."

    if not args.force:
        ttl = CACHE_TTL_SECONDS * 2 if args.limits_only else CACHE_TTL_SECONDS
        cached = get_cached_limits(ttl)
        if cached and "limits" in cached:
            limits = cached["limits"]

    access_token, token_err = get_valid_access_token()

    if access_token:
        email = get_cached_user_email(access_token)
        if limits is None:
            try:
                limits = fetch_authoritative_limits(access_token)
            except Exception as e:
                sys.stderr.write(f"omarchy-agent-usage-antigravity: failed to fetch quota after retries: {e}\n")
                limits = fetch_limits_via_agy()
                if not limits:
                    status_text = "Quota unavailable"
                    auth_help = f"Failed to retrieve quota: {e}"
    else:
        if limits is None:
            limits = fetch_limits_via_agy()
        if not limits:
            if not status_text:
                status_text = "Waiting for auth"
                auth_help = token_err or "Run `agy` to authenticate with Antigravity."

    if not email and (access_token or limits):
        email = get_cached_user_email(None)

    local_stats = collect_local_stats()
    now_iso = datetime.now(timezone.utc).isoformat()

    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": now_iso,
        "ready": True,
        "hasLocalStats": True,
        "tierLabel": f"Pro · {email}" if email else "Pro",
        "usageStatusText": status_text,
        "authHelpText": auth_help,
        "limits": limits or []
    }
    record.update(local_stats)

    print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
    main()
