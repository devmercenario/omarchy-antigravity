# Client errors that a retry can actually fix.
RETRYABLE_CLIENT_STATUSES = (408, 429)


class BoundedReadError(Exception):
    """Raised when a remote HTTP response exceeds its byte ceiling."""


class HttpFetchError(Exception):
    """Raised when a remote HTTP request fails or returns an invalid body."""

    def __init__(self, message, status=None):
        super().__init__(message)
        self.status = status


_deadline = None


def start_run_budget(seconds=RUN_BUDGET_SECONDS):
    global _deadline
    _deadline = time.monotonic() + seconds


def remaining_budget(cap):
    """Seconds one step may take: ``cap``, bounded by what is left of the run."""
    if _deadline is None:
        return cap
    return max(0.0, min(cap, _deadline - time.monotonic()))


class _NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Refuse HTTP redirects so credential-bearing requests are never replayed."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(
            req.full_url, code, f"refusing redirect to {newurl}", headers, fp
        )


# Refuse redirects process-wide: a redirect could replay the OAuth client secret
# and refresh token (or a quota bearer token) to an attacker-chosen host.
urllib.request.install_opener(urllib.request.build_opener(_NoRedirectHandler))


def debug_enabled():
    """True when verbose diagnostics are requested via env or ``--debug``."""
    return os.getenv("OMARCHY_ANTIGRAVITY_DEBUG", "").strip().lower() in (
        "1", "true", "yes", "on"
    )


def log_debug(message):
    if debug_enabled():
        sys.stderr.write(f"omarchy-agent-usage-antigravity: [debug] {message}\n")


def log_warn(message):
    sys.stderr.write(f"omarchy-agent-usage-antigravity: {message}\n")


def read_bounded(resp, max_bytes):
    """Read at most ``max_bytes`` bytes from an HTTP response body.

    Content-Length is checked when the server provides it and, regardless of
    what the server claims, no more than ``max_bytes`` + 1 bytes are ever read
    so an oversized or continuously delivered response cannot force unbounded
    allocation. Raises :class:`BoundedReadError` when the body is too large.
    """
    limit = max(1, int(max_bytes))

    headers = getattr(resp, "headers", None)
    if headers is not None:
        declared = None
        try:
            declared = headers.get("Content-Length")
        except Exception:
            declared = None
        if declared is not None:
            try:
                declared_length = int(declared)
            except (TypeError, ValueError):
                declared_length = None
            if declared_length is not None and declared_length > limit:
                raise BoundedReadError(
                    f"HTTP response Content-Length {declared_length} exceeds limit of {limit} bytes"
                )

    chunks = []
    remaining = limit + 1
    while remaining > 0:
        chunk = resp.read(min(65536, remaining))
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)

    body = b"".join(chunks)
    if len(body) > limit:
        raise BoundedReadError(f"HTTP response body exceeds limit of {limit} bytes")
    return body


def fetch_json(req, timeout, max_bytes, error_label):
    """Perform an HTTP request and parse a bounded JSON response.

    Both success bodies and HTTPError bodies are read through
    :func:`read_bounded` so every response and error path is size-limited, and
    ``timeout`` is cut to what is left of the run budget.
    """
    timeout = remaining_budget(timeout)
    if timeout <= 0:
        raise HttpFetchError(f"{error_label}: run time budget exhausted")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = read_bounded(resp, max_bytes)
    except urllib.error.HTTPError as e:
        detail = f"{error_label}: HTTP {e.code} {e.reason}".strip()
        snippet = ""
        try:
            snippet = read_bounded(e, min(max_bytes, HTTP_ERROR_BODY_MAX_BYTES)).decode(
                "utf-8", errors="replace"
            ).strip()
        except Exception:
            snippet = ""
        finally:
            try:
                e.close()
            except Exception:
                pass
        if snippet:
            detail = f"{detail}: {snippet[:512]}"
        raise HttpFetchError(detail, status=e.code) from e

    try:
        return json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as e:
        raise HttpFetchError(f"{error_label}: invalid JSON response") from e


def is_agy_running():
    """Check via OS process table (pgrep) if at least one agy process is active."""
    pgrep = resolve_tool("pgrep")
    if pgrep is None:
        return True
    try:
        res = subprocess.run(
            [pgrep, "-x", "agy"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2
        )
        return res.returncode == 0
    except Exception:
        return True


def ensure_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)
    try:
        st = os.lstat(path)
    except OSError:
        return
    if not stat.S_ISDIR(st.st_mode):
        raise OSError(f"Refusing to use a non-directory or symlink path: {path}")
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass


def _trusted_parent_chain(path):
    """True when every ancestor directory of ``path`` is trusted.

    Rejects world-writable directories and directories owned by neither root
    nor the current user, so a binary reached through an attacker-writable
    directory cannot be trusted even if its immediate parent looks safe.
    """
    current = os.path.dirname(path) or "/"
    uid = os.getuid()
    while True:
        try:
            st = os.stat(current)
        except OSError:
            return False
        if not stat.S_ISDIR(st.st_mode):
            return False
        if st.st_mode & 0o002:
            return False
        if st.st_uid not in (0, uid):
            return False
        parent = os.path.dirname(current)
        if parent == current:
            return True
        current = parent


def resolve_tool(name):
    """Resolve an external helper to an absolute path in a trusted directory.

    ``shutil.which`` honours ``PATH``; a poisoned ``PATH`` entry could otherwise
    substitute an attacker-controlled ``agy`` or ``secret-tool``. Reject
    candidates that are not executable regular files or whose parent chain
    contains a world-writable directory or a directory owned by neither root
    nor this user. Returns the resolved path, or ``None`` when nothing trusted
    is found.
    """
    path = shutil.which(name)
    if not path:
        return None
    try:
        path = os.path.realpath(path)
        st = os.stat(path)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode) or not os.access(path, os.X_OK):
        return None
    if not _trusted_parent_chain(path):
        return None
    return path


def get_token_from_file():
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(TOKEN_FILE, flags)
    except FileNotFoundError:
        return None, f"Token file not found: {TOKEN_FILE}"
    except OSError as e:
        return None, f"Failed to open token file: {e}"

    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, f"Token file is not a regular file: {TOKEN_FILE}"
        if st.st_uid != os.getuid():
            return None, f"Token file owner mismatch (uid {st.st_uid} != {os.getuid()}): {TOKEN_FILE}"
        if (st.st_mode & 0o077) != 0:
            return None, f"Token file has insecure permissions ({oct(st.st_mode & 0o777)}), must be private to owner (0600)"
        if st.st_size > MAX_TOKEN_FILE_SIZE:
            return None, f"Token file exceeds maximum allowed size ({st.st_size} > {MAX_TOKEN_FILE_SIZE} bytes)"

        raw = os.read(fd, MAX_TOKEN_FILE_SIZE + 1)
        if len(raw) > MAX_TOKEN_FILE_SIZE:
            return None, f"Token file content exceeds maximum allowed size of {MAX_TOKEN_FILE_SIZE} bytes"

        data = json.loads(raw.decode("utf-8"))
        if not data or not isinstance(data, dict) or "token" not in data:
            return None, "Invalid token structure in token file"
        return data, ""
    except Exception as e:
        return None, f"Failed to read token file: {e}"
    finally:
        os.close(fd)


def get_token_from_keyring():
    secret_tool = resolve_tool("secret-tool")
    if secret_tool is None:
        return None, "secret-tool is not available in a trusted PATH"
    try:
        code, raw_bytes, truncated = run_bounded_stdout(
            [secret_tool, "lookup", "service", "gemini", "username", "antigravity"],
            timeout=5,
        )
        if truncated:
            return None, "Keyring credential exceeds maximum allowed size"
        if code != 0:
            return None, "No Antigravity credentials found in keyring"
        raw = raw_bytes.decode("utf-8", errors="ignore").strip()
        if not raw:
            return None, "No Antigravity credentials found in keyring"
        data = json.loads(raw)
        return data, ""
    except Exception as e:
        return None, f"Failed to read keyring: {e}"


def get_credentials():
    data, err_file = get_token_from_file()
    if data:
        return data, "file", ""

    data, err_keyring = get_token_from_keyring()
    if data:
        return data, "keyring", ""

    return None, None, f"No Antigravity credentials found in token file or keyring ({err_file}; {err_keyring})"


def _validate_private_descriptor(fd, label):
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode):
        raise OSError(f"Temporary file is not a regular file: {label}")
    if st.st_uid != os.getuid():
        raise OSError(f"Temporary file owner mismatch (uid {st.st_uid} != {os.getuid()})")
    if (st.st_mode & 0o077) != 0:
        raise OSError(f"Temporary file has insecure permissions ({oct(st.st_mode & 0o777)})")


def _write_all(fd, payload):
    total_written = 0
    while total_written < len(payload):
        written = os.write(fd, payload[total_written:])
        if written == 0:
            raise OSError("Failed to write payload to temporary file")
        total_written += written


def atomic_write_private(file_path, data, max_bytes=None, error_label="private file"):
    """Atomically publish ``data`` as private JSON to ``file_path``.

    The temporary file is created with ``mkstemp`` (mode 0600, ``O_EXCL``) in the
    target directory, validated on its descriptor, written, fsynced, and
    published with ``os.replace`` so an existing symlink is replaced rather than
    followed. Shared by every cache the collector persists.
    """
    fd = None
    tmp_path = None
    try:
        parent_dir = os.path.dirname(file_path)
        ensure_dir(parent_dir)

        prefix = f".{os.path.basename(file_path)}.tmp."
        fd, tmp_path = tempfile.mkstemp(dir=parent_dir, prefix=prefix)
        _validate_private_descriptor(fd, tmp_path)

        payload = json.dumps(data, indent=2).encode("utf-8")
        if max_bytes is not None and len(payload) > max_bytes:
            raise ValueError(
                f"{error_label} payload exceeds maximum allowed size "
                f"({len(payload)} > {max_bytes} bytes)"
            )
        _write_all(fd, payload)

        os.fsync(fd)
        os.close(fd)
        fd = None

        os.replace(tmp_path, file_path)
        tmp_path = None
        return True
    except Exception as e:
        log_warn(f"failed to save {error_label}: {e}")
        return False
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
        if tmp_path is not None:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass


def save_private_json(file_path, data):
    return atomic_write_private(file_path, data)


def read_token():
    """Return ``(token, error)`` from agy's stored credentials, read-only."""
    data, _source, err = get_credentials()
    token = data.get("token") if isinstance(data, dict) else None
    if not isinstance(token, dict):
        return None, err or "Invalid token structure in Antigravity credentials"
    return token, ""


def account_id(token):
    """Short, non-secret fingerprint of the signed-in account's credentials."""
    refresh_token = token.get("refresh_token") if isinstance(token, dict) else None
    if not isinstance(refresh_token, str) or not refresh_token:
        return ""
    return hashlib.sha256(refresh_token.encode("utf-8")).hexdigest()[:16]


def _token_fresh(expiry):
    """True while an access token has more than two minutes left.

    A token without an expiry is trusted as before; one whose expiry cannot be
    parsed is treated as stale so it gets replaced.
    """
    if not expiry:
        return True
    try:
        exp_dt = datetime.fromisoformat(str(expiry))
    except ValueError:
        return False
    if exp_dt.tzinfo is None:
        exp_dt = exp_dt.replace(tzinfo=timezone.utc)
    return (exp_dt - datetime.now(timezone.utc)).total_seconds() >= 120


def _refresh_access_token(refresh_token):
    """Mint a new access token; returns ``(access_token, expiry_iso)``."""
    if STRICT_CLIENT and not (
        os.getenv("ANTIGRAVITY_CLIENT_ID") and os.getenv("ANTIGRAVITY_CLIENT_SECRET")
    ):
        raise RuntimeError(
            "strict client mode requires ANTIGRAVITY_CLIENT_ID and "
            "ANTIGRAVITY_CLIENT_SECRET; refusing to use the built-in default"
        )
    params = urllib.parse.urlencode({
        "client_id": OAUTH_CLIENT_ID,
        "client_secret": OAUTH_CLIENT_SECRET,
        "refresh_token": refresh_token,
        "grant_type": "refresh_token"
    }).encode("utf-8")
    req = urllib.request.Request("https://oauth2.googleapis.com/token", data=params, method="POST")
    res = fetch_json(
        req,
        timeout=10,
        max_bytes=OAUTH_TOKEN_RESPONSE_MAX_BYTES,
        error_label="OAuth token refresh failed",
    )
    new_token = res.get("access_token")
    if not new_token:
        raise HttpFetchError("OAuth token refresh failed: no access_token in response")
    expires_in = res.get("expires_in", 3600)
    if not isinstance(expires_in, (int, float)):
        expires_in = 3600
    expiry = datetime.now(timezone.utc) + timedelta(seconds=expires_in)
    return new_token, expiry.isoformat()


def get_valid_access_token(token, token_err=""):
    """Return ``(access_token, error)`` for agy's credentials.

    agy's own access token is used while it is fresh. Otherwise the collector
    refreshes one for itself and keeps it in its own private cache, keyed by
    account, so agy's token file and keyring entry are only ever read and the
    collector never races the CLI's own token refresh.
    """
    if not isinstance(token, dict):
        return None, token_err or "No Antigravity credentials found"

    access_token = token.get("access_token")
    if access_token and _token_fresh(token.get("expiry")):
        return access_token, ""

    account = account_id(token)
    cached, _ = read_private_json(ACCESS_TOKEN_CACHE_FILE)
    if (
        account
        and isinstance(cached, dict)
        and cached.get("account") == account
        and cached.get("access_token")
        and _token_fresh(cached.get("expiry"))
    ):
        return cached["access_token"], ""

    refresh_token = token.get("refresh_token")
    if refresh_token:
        try:
            new_token, expiry = _refresh_access_token(refresh_token)
            save_private_json(ACCESS_TOKEN_CACHE_FILE, {
                "account": account,
                "access_token": new_token,
                "expiry": expiry,
            })
            return new_token, ""
        except Exception as e:
            log_warn(f"token refresh error: {e}")

    if access_token:
        # Best effort: the server is the judge of a token we could not renew.
        return access_token, ""
    return None, "Unable to obtain valid access token"


def read_private_json(file_path, max_bytes=MAX_CACHE_FILE_SIZE):
    """Read a user-owned JSON file through a bounded, no-follow descriptor.

    Rejects symlinks, non-regular files, files owned by another user, and
    payloads larger than ``max_bytes`` before any decoding or parsing happens.
    Returns ``(data, stat_result)`` on success and ``(None, None)`` otherwise.
    """
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(file_path, flags)
    except OSError:
        return None, None

    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, None
        if st.st_uid != os.getuid():
            return None, None
        if st.st_size > max_bytes:
            return None, None
        raw = os.read(fd, max_bytes + 1)
        if len(raw) > max_bytes:
            return None, None
        return json.loads(raw.decode("utf-8")), st
    except Exception:
        return None, None
    finally:
        os.close(fd)


def run_bounded_stdout(args, timeout, max_bytes=MAX_SUBPROCESS_OUTPUT_BYTES):
    """Run a command and capture a bounded amount of stdout.

    Returns ``(returncode, stdout_bytes, truncated)``. The child is killed when
    it produces more than ``max_bytes`` or exceeds ``timeout`` seconds (cut to
    the run budget) so a misbehaving helper cannot force unbounded allocation.
    The child gets its own process group and the whole group is killed, so
    helpers it started (agy's MCP servers) are not left orphaned.
    """
    timeout = remaining_budget(timeout)
    if timeout <= 0:
        return None, b"", True
    try:
        proc = subprocess.Popen(
            args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True
        )
    except OSError:
        return None, b"", False
    _active_procs.add(proc)

    state = {"data": bytearray(), "truncated": False}

    def _reader():
        try:
            while True:
                chunk = proc.stdout.read(65536)
                if not chunk:
                    break
                if len(state["data"]) + len(chunk) > max_bytes:
                    state["truncated"] = True
                    kill_process_tree(proc)
                    break
                state["data"].extend(chunk)
        except Exception:
            pass

    reader = threading.Thread(target=_reader, daemon=True)
    reader.start()
    try:
        returncode = proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        state["truncated"] = True
        kill_process_tree(proc)
        returncode = proc.wait()
    finally:
        _active_procs.discard(proc)
    reader.join(timeout=2)
    if proc.stdout is not None:
        try:
            proc.stdout.close()
        except OSError:
            pass
    return returncode, bytes(state["data"]), state["truncated"]


_active_procs = set()


def kill_process_tree(proc):
    """SIGKILL a child started by :func:`run_bounded_stdout` and its group."""
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    except OSError:
        proc.kill()


def _terminate_children(signum, _frame):
    # `timeout` in the updater signals only our own process group; the
    # helpers live in their own groups and would outlive us otherwise.
    for proc in list(_active_procs):
        kill_process_tree(proc)
    sys.exit(128 + signum)


def get_cached_limits(max_age_seconds=CACHE_TTL_SECONDS, path=None):
    data, st = read_private_json(path or CACHE_FILE)
    if not isinstance(data, dict):
        return None
    if time.time() - st.st_mtime > max_age_seconds:
        return None
    return data


def _fetch_email(access_token):
    try:
        req = urllib.request.Request(
            "https://www.googleapis.com/oauth2/v2/userinfo",
            headers={"Authorization": f"Bearer {access_token}"},
        )
        info = fetch_json(
            req,
            timeout=5,
            max_bytes=USERINFO_RESPONSE_MAX_BYTES,
            error_label="Google userinfo request failed",
        )
        email = info.get("email") if isinstance(info, dict) else None
        return email if isinstance(email, str) else ""
    except Exception as e:
        log_debug(f"userinfo lookup failed: {e}")
        return ""


def _fetch_tier(access_token):
    """The account's plan name, e.g. "Google AI Pro", as agy's backend reports it."""
    try:
        req = urllib.request.Request(
            f"{CODE_ASSIST_ENDPOINT}:loadCodeAssist",
            data=json.dumps({"metadata": {"ideType": "ANTIGRAVITY"}}).encode("utf-8"),
            headers={
                "Authorization": f"Bearer {access_token}",
                "Content-Type": "application/json",
                "User-Agent": "antigravity",
            },
            method="POST",
        )
        info = fetch_json(
            req,
            timeout=5,
            max_bytes=CODE_ASSIST_RESPONSE_MAX_BYTES,
            error_label="loadCodeAssist request failed",
        )
    except Exception as e:
        log_debug(f"tier lookup failed: {e}")
        return ""
    if not isinstance(info, dict):
        return ""
    for key in ("paidTier", "currentTier"):
        tier = info.get(key)
        name = tier.get("name") if isinstance(tier, dict) else None
        if isinstance(name, str) and name.strip():
            return name.strip()
    return ""


def resolve_account(account, get_access_token):
    """Return ``(email, tier)`` for the signed-in account.

    Cached per account fingerprint, so switching accounts in agy is picked up
    instead of showing the previous account forever. The network is only hit
    on a cache miss, and only then is an access token minted.
    """
    if not account:
        return "", ""
    cached, _ = read_private_json(ACCOUNT_CACHE_FILE)
    if isinstance(cached, dict) and cached.get("account") == account:
        return str(cached.get("email") or ""), str(cached.get("tier") or "")
    access_token = get_access_token()
    if not access_token:
        return "", ""
    email = _fetch_email(access_token)
    tier = _fetch_tier(access_token)
    # An empty answer is a failed lookup, not an account without an email;
    # caching it would hide the email until the next account switch.
    if email:
        save_private_json(ACCOUNT_CACHE_FILE, {"account": account, "email": email, "tier": tier})
    return email, tier


def _used_fraction(remaining):
    return round(max(0.0, min(1.0, 1.0 - remaining)), 4)


def _group_display(group_name):
    """Map a quota group to its short display name and sort priority.

    Only the two shared pools get short names. Any other group, such as a
    per-model pool like "Gemini 4 Argon", keeps its own name so it never
    collides with, and silently overwrites, the shared Gemini meter.
    """
    name = (group_name or "").strip()
    upper = name.upper()
    if upper.startswith("GEMINI") and "MODEL" in upper:
        return "Gemini", 0
    if "CLAUDE" in upper or "GPT" in upper:
        return "Claude/GPT", 1
    return name, 2


def _limit_entry(group_name, window, bucket_name, used_pct, reset_time):
    """Classify one quota bucket into an ordered, display-ready limit record.

    Shared by the authoritative API parser and the ``agy -p /usage`` reader so
    both express identical group/window precedence.
    """
    bucket = (bucket_name or "").upper()
    win = (window or "").upper()
    prefix, group_priority = _group_display(group_name)

    if win in ("5H", "FIVE HOUR") or "FIVE HOUR" in bucket or "5-HOUR" in bucket:
        title, label, window_priority = f"{prefix} (5h)", "Session", 0
    elif win == "WEEKLY" or "WEEKLY" in bucket:
        title, label, window_priority = f"{prefix} (Weekly)", "Weekly", 1
    else:
        title, label, window_priority = f"{prefix} ({bucket_name})", bucket_name, 2

    return (group_priority, window_priority, {
        "title": title,
        "label": label,
        "percent": used_pct,
        "resetsAt": reset_time,
    })


def _finalize_limits(parsed_items):
    parsed_items.sort(key=lambda x: (x[0], x[1]))
    return [item[2] for item in parsed_items]


def limit_group(limit):
    """Display group of a limit record, read back from its title ("Gemini (5h)")."""
    title = str(limit.get("title", "")) if isinstance(limit, dict) else ""
    return title.rsplit(" (", 1)[0] if " (" in title else title


def _limit_sort_key(limit):
    """Same order as :func:`_finalize_limits`, for records already titled."""
    group = limit_group(limit)
    group_priority = SHARED_LIMIT_GROUPS.index(group) if group in SHARED_LIMIT_GROUPS else 2
    window_priority = {"Session": 0, "Weekly": 1}.get(limit.get("label"), 2)
    return group_priority, window_priority


def _retryable(error):
    if isinstance(error, BoundedReadError):
        # An oversized response is deterministic: retrying cannot help.
        return False
    status = getattr(error, "status", None)
    return not (status and 400 <= status < 500 and status not in RETRYABLE_CLIENT_STATUSES)


def fetch_authoritative_limits(access_token):
    headers = {
        "Authorization": f"Bearer {access_token}",
        "Content-Type": "application/json",
        "User-Agent": "antigravity"
    }
    payload = json.dumps({"project": "default-cli-project"}).encode("utf-8")

    last_err = None
    data = None
    for attempt in range(MAX_RETRIES + 1):
        try:
            req = urllib.request.Request(QUOTA_ENDPOINT, data=payload, headers=headers, method="POST")
            data = fetch_json(
                req,
                timeout=10,
                max_bytes=QUOTA_RESPONSE_MAX_BYTES,
                error_label="quota request failed",
            )
            break
        except Exception as e:
            # A 401/403 or an oversized body will not change on a second try.
            if not _retryable(e):
                raise
            last_err = e
            if attempt < MAX_RETRIES and remaining_budget(RETRY_DELAY_SECONDS + 1) > RETRY_DELAY_SECONDS:
                time.sleep(RETRY_DELAY_SECONDS)

    if not isinstance(data, dict):
        raise last_err or HttpFetchError("quota request failed: unexpected response shape")

    parsed_items = []
    for group in data.get("groups") or []:
        if not isinstance(group, dict):
            continue
        gname = group.get("displayName", "")
        for b in group.get("buckets") or []:
            if not isinstance(b, dict):
                continue
            parsed_items.append(_limit_entry(
                gname,
                b.get("window", ""),
                b.get("displayName", ""),
                _used_fraction(b.get("remainingFraction", 1.0)),
                b.get("resetTime", ""),
            ))

    return _finalize_limits(parsed_items)


def _parse_agy_usage_text(text):
    """Parse the ``/usage`` table: group, bucket, remaining %, reset time.

    Rows are matched by shape rather than by known group names so a pool the
    CLI adds later still reaches the panel.
    """
    parsed_items = []
    for line in text.splitlines():
        fields = re.split(r"\t+|\s{2,}", line.strip())
        if len(fields) != 4:
            continue
        group, bucket, pct, reset = fields
        m = re.fullmatch(r"(\d+)%", pct)
        if not m:
            continue
        parsed_items.append(_limit_entry(
            group, "", bucket, _used_fraction(int(m.group(1)) / 100.0), reset
        ))
    return parsed_items


def _parse_agy_usage_json(raw):
    """Parse ``agy -p /usage --output-format json``.

    Returns ``None`` when ``raw`` is not JSON at all so the caller can read it
    as the plain table an older CLI prints.
    """
    try:
        doc = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(doc, dict):
        return None
    command = doc.get("command")
    data = command.get("data") if isinstance(command, dict) else None
    groups = data.get("groups") if isinstance(data, dict) else None
    if not isinstance(groups, list):
        return _parse_agy_usage_text(str(doc.get("response") or ""))

    parsed_items = []
    for group in groups:
        if not isinstance(group, dict):
            continue
        for b in group.get("buckets") or []:
            if not isinstance(b, dict) or b.get("disabled"):
                continue
            rem = b.get("remaining_fraction")
            if isinstance(rem, bool) or not isinstance(rem, (int, float)):
                log_debug(f"skipping bucket without remaining_fraction: {b.get('id')}")
                continue
            parsed_items.append(_limit_entry(
                group.get("name", ""),
                b.get("window", ""),
                b.get("name", ""),
                _used_fraction(rem),
                b.get("reset_time", ""),
            ))
    return parsed_items


def fetch_limits_via_agy():
    """Read quota through the official CLI's ``/usage`` command.

    Its structured output carries every pool the CLI shows, including the
    Gemini ones the quota API stopped returning. Each call starts the user's
    MCP servers, so callers go through :func:`get_agy_limits` and its cache.
    """
    agy = resolve_tool("agy")
    if agy is None:
        return None
    try:
        # --log-file keeps these background probes from rotating the user's
        # own session logs out of ~/.gemini/antigravity-cli/log.
        code, stdout_bytes, truncated = run_bounded_stdout(
            [agy, "--log-file", os.devnull, "-p", "/usage", "--output-format", "json"],
            timeout=AGY_USAGE_TIMEOUT_SECONDS,
        )
        if truncated:
            log_warn("agy -p /usage output exceeded size or time limit")
            return None
        if code != 0:
            log_debug(f"agy -p /usage exited with {code}")
            return None
        raw = stdout_bytes.decode("utf-8", errors="replace").strip()
        parsed_items = _parse_agy_usage_json(raw)
        if parsed_items is None:
            parsed_items = _parse_agy_usage_text(raw)
        if parsed_items:
            return _finalize_limits(parsed_items)
    except Exception as e:
        log_warn(f"agy -p /usage error: {e}")
    return None


def get_agy_limits(force=False):
    """agy's /usage answer, reused for AGY_USAGE_TTL_SECONDS unless forced.

    A failed call is cached too: an agy that cannot answer would otherwise be
    relaunched, MCP servers and all, on every refresh.
    """
    if not force:
        cached = get_cached_limits(AGY_USAGE_TTL_SECONDS, AGY_CACHE_FILE)
        if cached is not None and "limits" in cached:
            log_debug("agy usage cache hit")
            limits = cached["limits"]
            return limits if isinstance(limits, list) else None
    limits = fetch_limits_via_agy()
    save_private_json(AGY_CACHE_FILE, {"limits": limits, "fetchedAt": time.time()})
    return limits


def count_dir_entries(directory, limit=10000):
    """Count entries in a directory with a hard cap, tolerating unreadable dirs."""
    count = 0
    try:
        with os.scandir(directory) as entries:
            for _ in entries:
                count += 1
                if count >= limit:
                    break
    except OSError:
        return 0
    return count


def _history_cache_key(history_file):
    """Return a (mtime_ns, size) cache key, or None when the file is unusable."""
    try:
        st = os.lstat(history_file)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode):
        return None
    if st.st_uid != os.getuid() or st.st_size > MAX_HISTORY_FILE_SIZE:
        return None
    return [st.st_mtime_ns, st.st_size]


def _scan_history(history_file, today_str, recent_days_map):
    """Stream history.jsonl; returns (total prompts, today's prompts, today's sessions).

    Sessions are today's distinct conversation ids. Prompts logged without one
    (agy writes a few) count together as a single extra session, so the number
    never exceeds the prompts behind it.
    """
    total_prompts = 0
    today_prompts = 0
    today_conversations = set()
    today_without_id = False
    fd = None
    try:
        flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
        fd = os.open(history_file, flags)
        st = os.fstat(fd)
        if (
            stat.S_ISREG(st.st_mode)
            and st.st_uid == os.getuid()
            and st.st_size <= MAX_HISTORY_FILE_SIZE
        ):
            with os.fdopen(fd, "r", encoding="utf-8", errors="ignore") as f:
                fd = None
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        data = json.loads(line)
                        ts = data.get("timestamp", 0)
                        if ts > 1e11:
                            ts = ts / 1000.0
                        dt = datetime.fromtimestamp(ts).astimezone()
                        d_str = dt.strftime("%Y-%m-%d")
                        total_prompts += 1
                        if d_str == today_str:
                            today_prompts += 1
                            conversation = data.get("conversationId")
                            if isinstance(conversation, str) and conversation:
                                today_conversations.add(conversation)
                            else:
                                today_without_id = True
                        if d_str in recent_days_map:
                            recent_days_map[d_str] += 1
                    except Exception:
                        continue
    except OSError:
        pass
    finally:
        if fd is not None:
            try:
                os.close(fd)
            except OSError:
                pass
    return total_prompts, today_prompts, len(today_conversations) + int(today_without_id)


def collect_local_stats():
    now = datetime.now().astimezone()
    today_str = now.strftime("%Y-%m-%d")

    recent_days_map = {}
    for i in range(7):
        d = (now - timedelta(days=6-i)).strftime("%Y-%m-%d")
        recent_days_map[d] = 0

    history_file = HISTORY_FILE
    brain_dir = BRAIN_DIR

    total_prompts = 0
    today_prompts = 0
    today_sessions = 0

    # Cache the history scan when the file is unchanged and the local day has
    # not rolled over; the cache key is validated through the private reader.
    history_key = _history_cache_key(history_file)
    cached, _ = read_private_json(HISTORY_CACHE_FILE)
    cache_hit = False
    if (
        history_key is not None
        and isinstance(cached, dict)
        and cached.get("historyKey") == history_key + [today_str]
        and "todaySessions" in cached
    ):
        total_prompts = int(cached.get("totalPrompts", 0))
        today_prompts = int(cached.get("todayPrompts", 0))
        today_sessions = int(cached.get("todaySessions", 0))
        for day in cached.get("recentDays", []):
            date = day.get("date")
            if date in recent_days_map:
                recent_days_map[date] = int(day.get("messageCount", 0))
        cache_hit = True
        log_debug(f"history cache hit ({history_key[1]} bytes)")

    if not cache_hit:
        total_prompts, today_prompts, today_sessions = _scan_history(
            history_file, today_str, recent_days_map
        )
        if history_key is not None:
            save_private_json(HISTORY_CACHE_FILE, {
                "historyKey": history_key + [today_str],
                "totalPrompts": total_prompts,
                "todayPrompts": today_prompts,
                "todaySessions": today_sessions,
                "recentDays": [
                    {"date": k, "messageCount": v} for k, v in recent_days_map.items()
                ],
            })
        log_debug(f"history scanned ({history_key[1] if history_key else 0} bytes)")

    recent_days = [{"date": k, "messageCount": v} for k, v in recent_days_map.items()]
    active_dates = [k for k, v in recent_days_map.items() if v > 0]
    total_sessions = count_dir_entries(brain_dir) if os.path.isdir(brain_dir) else 1

    return {
        "todayPrompts": today_prompts,
        "todaySessions": today_sessions,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": recent_days,
        "totalPrompts": total_prompts,
        "totalSessions": total_sessions,
        "activeDays": len(active_dates),
        "activeDates": active_dates,
        "modelUsage": {}
    }


def _resolve_limits(get_token, force, status_text, auth_help):
    """Combine the quota API with agy's /usage into one list of limits.

    The API is cheap and stays the source for every pool it reports. agy is
    consulted, through its long-lived cache, only when the API leaves out a
    shared pool or one seen recently, e.g. the Gemini pools it stopped
    returning and per-model pools such as "Gemini 4 Argon".
    """
    access_token, token_err = get_token()
    api_limits, api_error = None, None
    if access_token:
        try:
            api_limits = fetch_authoritative_limits(access_token)
        except Exception as e:
            api_error = e
            log_warn(f"failed to fetch quota after retries: {e}")

    have = {limit_group(item) for item in api_limits or []}
    wanted = set(SHARED_LIMIT_GROUPS) | known_limit_groups()
    agy_limits = None
    if api_limits is None or not wanted <= have:
        agy_limits = get_agy_limits(force)

    if api_limits is None and agy_limits is None:
        if not status_text and access_token:
            status_text = "Quota unavailable"
            auth_help = f"Failed to retrieve quota: {api_error}"
        elif not status_text:
            status_text = "Waiting for auth"
            auth_help = token_err or "Run `agy` to authenticate with Antigravity."
        return None, status_text, auth_help

    merged = list(api_limits or [])
    merged += [item for item in agy_limits or [] if limit_group(item) not in have]
    limits = sorted(merged, key=_limit_sort_key)
    save_private_json(CACHE_FILE, {"limits": limits, "fetchedAt": time.time()})
    return limits, status_text, auth_help


def _read_seen_groups():
    seen, _ = read_private_json(GROUPS_STATE_FILE)
    if not isinstance(seen, dict):
        return {}
    return {
        str(group): float(ts) for group, ts in seen.items()
        if isinstance(ts, (int, float)) and not isinstance(ts, bool)
    }


def known_limit_groups(now=None):
    """Pools reported within GROUP_MEMORY_SECONDS."""
    now = time.time() if now is None else now
    return {g for g, ts in _read_seen_groups().items() if now - ts <= GROUP_MEMORY_SECONDS}


def track_limit_groups(limits, now=None):
    """Remember the pools in ``limits``; return recently seen ones now missing.

    Timestamps are only rewritten when they are an hour old, so a steady state
    does not cost a disk write per refresh.
    """
    now = time.time() if now is None else now
    seen = _read_seen_groups()
    current = {limit_group(item) for item in limits or []} - {""}
    missing = sorted(
        g for g, ts in seen.items() if g not in current and now - ts <= GROUP_MEMORY_SECONDS
    )
    updated = {g: ts for g, ts in seen.items() if now - ts <= GROUP_MEMORY_SECONDS}
    for group in current:
        if now - updated.get(group, 0) > GROUP_SEEN_REFRESH_SECONDS:
            updated[group] = now
    if updated != seen:
        save_private_json(GROUPS_STATE_FILE, updated)
    return missing


def _check_limits_complete(limits, status_text, auth_help):
    """Flag a quota response that dropped a pool it reported recently.

    Without this an upstream format change only shows up as a meter quietly
    vanishing from the panel. Pools are compared against what this account
    reported over the last week rather than a fixed list, so a plan without
    one of the shared pools is not flagged forever.
    """
    if status_text:
        return status_text, auth_help
    missing = track_limit_groups(limits)
    if limits and not missing:
        return status_text, auth_help
    what = f"the {' and '.join(missing)} quota" if missing else "any quota"
    log_warn(f"quota response is missing {what}")
    return "Usage incomplete", (
        f"Antigravity stopped reporting {what}, so its usage format may have "
        "changed. Compare with /usage in agy."
    )


def notify_status_change(status_text, detail):
    """Raise one desktop notification when the usage status turns into a problem.

    A problem notifies on its second consecutive sighting, so one network blip
    stays quiet; it then stays quiet until the status changes, and recovering
    re-arms the alert.
    """
    state, _ = read_private_json(ALERT_STATE_FILE)
    state = state if isinstance(state, dict) else {}
    if state.get("status", "") != status_text:
        save_private_json(ALERT_STATE_FILE, {"status": status_text, "notified": False})
        return
    if not status_text or state.get("notified"):
        return
    save_private_json(ALERT_STATE_FILE, {"status": status_text, "notified": True})
    notify_send = resolve_tool("notify-send")
    if notify_send is None:
        return
    try:
        # Notification daemons such as mako render the body as Pango markup.
        subprocess.run(
            [
                notify_send, "--app-name=Antigravity",
                f"Antigravity: {status_text}", html.escape(detail or "", quote=False),
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
    except Exception as e:
        log_warn(f"failed to send desktop notification: {e}")


def _build_record(email, tier, status_text, auth_help, limits, local_stats):
    """Assemble the display-ready usage record emitted on stdout."""
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": True,
        "tierLabel": " · ".join(part for part in (tier, email) if part),
        "usageStatusText": status_text,
        "authHelpText": auth_help,
        # Only an auth problem gets the panel's Sign In button; signing in
        # again cannot fix an outage or a changed usage format.
        "authRequired": status_text == "Waiting for auth",
        "limits": limits or [],
        # history.jsonl counts prompts, while other agents' recentDays count
        # tokens; the panel labels the chart from this.
        "recentDaysUnit": "prompts",
    }
    record.update(local_stats)
    return record


def _error_record(error):
    """Last-resort record so a crash shows up in the panel.

    Without it the updater keeps the previous record and the panel silently
    freezes on stale numbers. The last limits are kept for context.
    """
    limits = []
    try:
        cached, _ = read_private_json(CACHE_FILE)
        if isinstance(cached, dict) and isinstance(cached.get("limits"), list):
            limits = cached["limits"]
    except Exception:
        pass
    return _build_record(
        "", "", "Collector error",
        f"The Antigravity usage collector failed: {error}", limits, {},
    )


def _run(args):
    # When not forced and an existing state file already exists, only query remote servers
    # if there is at least one active 'agy' session running on the machine.
    if not args.force and os.path.exists(STATE_FILE) and not is_agy_running():
        log_warn("no active agy session running; skipping update")
        return

    limits = None
    status_text = ""
    auth_help = ""

    if resolve_tool("agy") is None:
        status_text = "Not installed"
        auth_help = "Antigravity CLI ('agy') is not found in PATH."

    token, cred_err = read_token()
    account = account_id(token)
    token_state = {}

    def get_token():
        # Most runs are served from caches; mint a token only when one is used.
        if "result" not in token_state:
            token_state["result"] = get_valid_access_token(token, cred_err)
            log_debug(f"access token resolved: {'yes' if token_state['result'][0] else 'no'}")
        return token_state["result"]

    if not args.force:
        ttl = CACHE_TTL_SECONDS * 2 if args.limits_only else CACHE_TTL_SECONDS
        cached = get_cached_limits(ttl)
        if cached and isinstance(cached.get("limits"), list):
            limits = cached["limits"]
            log_debug("limits cache hit")

    if limits is None:
        limits, status_text, auth_help = _resolve_limits(
            get_token, args.force, status_text, auth_help
        )
    status_text, auth_help = _check_limits_complete(limits, status_text, auth_help)
    notify_status_change(status_text, auth_help)
    email, tier = resolve_account(account, lambda: get_token()[0])

    record = _build_record(email, tier, status_text, auth_help, limits, collect_local_stats())
    print(json.dumps(record, separators=(",", ":")))


def main(argv=None):
    parser = argparse.ArgumentParser(description="Collect Antigravity usage record")
    parser.add_argument("--force", action="store_true", help="Bypass probe cache and active session check")
    parser.add_argument("--limits-only", action="store_true", help="Prioritize speed/cache")
    parser.add_argument("--debug", action="store_true", help="Print verbose diagnostics to stderr")
    args = parser.parse_args(argv)

    if args.debug:
        os.environ["OMARCHY_ANTIGRAVITY_DEBUG"] = "1"
    log_debug(f"start force={args.force} limits_only={args.limits_only}")
    start_run_budget()

    try:
        _run(args)
    except Exception as e:
        log_warn(f"collector error: {e!r}")
        try:
            notify_status_change("Collector error", str(e))
        except Exception:
            pass
        print(json.dumps(_error_record(e), separators=(",", ":")))
    return 0


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, _terminate_children)
    sys.exit(main())
