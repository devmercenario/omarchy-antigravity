# Whole-run wall-clock budget, kept under the updater's `timeout 60` so a slow
# network ends in a record that says so instead of a killed collector. Every
# request and helper is cut to what is left of it; one socket read already in
# progress (at most 10 s) and the 5 s notification are the only overrun.
RUN_BUDGET_SECONDS = 40
# DNS, connect, TLS and a trickled status line are not cut by the budget, and
# signal handlers cannot run while Python is blocked in C: a watchdog thread
# ends the run this long after the budget, still well inside `timeout 60`.
