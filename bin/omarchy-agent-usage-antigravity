# Conservative per-endpoint ceilings for remote response bodies. These bound how
# much memory a compromised or misbehaving endpoint can make the collector
# allocate before the body is rejected.
OAUTH_TOKEN_RESPONSE_MAX_BYTES = 16 * 1024
